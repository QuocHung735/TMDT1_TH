@using System.Globalization
@using System.Text.Json
@model TMDT1_TH.ViewModels.Storefront.StoreProductDetailsViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = Model.Name;
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var primaryImage = Model.Images.FirstOrDefault(x => x.IsPrimary)
        ?? Model.Images.FirstOrDefault();
    var variantJson = JsonSerializer.Serialize(
        Model.Variants,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
    var canBuySimpleProduct =
        !Model.HasVariants &&
        Model.SalePrice.HasValue &&
        Model.StockQuantity >= Model.MinPurchaseQuantity;
}

<style>
    .marketplace-seller-card {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 16px 0;
        padding: 14px;
        border: 1px solid #e8e1ee;
        border-radius: 16px;
        background: #fcfaff;
    }

    .marketplace-seller-card__logo {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        overflow: hidden;
        border-radius: 14px;
        background: #eee7f4;
        color: #684983;
        font-weight: 800;
    }

    .marketplace-seller-card__logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .marketplace-seller-card__content {
        display: grid;
        gap: 3px;
    }

    .marketplace-seller-card__content small {
        color: #81758b;
        font-size: 11px;
        letter-spacing: .08em;
    }

    .marketplace-seller-card__content strong {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .marketplace-seller-card__content strong i {
        color: #76539b;
    }

    .marketplace-seller-card__content span {
        color: #706779;
        font-size: 13px;
    }
</style>
<section class="product-breadcrumb">
    <div class="store-container">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        <span>/</span>
        <a asp-controller="Home"
           asp-action="Catalog"
           asp-route-category="@Model.CategorySlug">@Model.CategoryName</a>
        <span>/</span>
        <strong>@Model.Name</strong>
    </div>
</section>

<section class="store-section product-detail">
    <div class="store-container product-detail__grid"
         data-product-details
         data-product-id="@Model.Id"
         data-has-variants="@Model.HasVariants.ToString().ToLowerInvariant()"
         data-currency="@Model.CurrencyCode"
         data-simple-price-available="@Model.SalePrice.HasValue.ToString().ToLowerInvariant()"
         data-simple-stock="@Model.StockQuantity"
         data-min-purchase="@Model.MinPurchaseQuantity"
         data-max-purchase="@Model.MaxPurchaseQuantity">
        <div class="product-gallery">
            <div class="product-gallery__main">
                @if (primaryImage is not null)
                {
                    <img src="@primaryImage.Url"
                         alt="@primaryImage.AltText"
                         data-main-product-image />
                }
                else
                {
                    <div class="product-gallery__placeholder" data-main-product-image>
                        Mây Home
                    </div>
                }
            </div>

            @if (Model.Images.Count > 1)
            {
                <div class="product-gallery__thumbs">
                    @foreach (var image in Model.Images)
                    {
                        <button type="button"
                                class="@(image == primaryImage ? "is-active" : "")"
                                data-gallery-image="@image.Url"
                                aria-label="Xem ảnh @image.AltText">
                            <img src="@image.Url" alt="@image.AltText" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="product-summary">
            <p class="product-summary__brand">@Model.BrandName · @Model.CategoryName</p>
            <h1>@Model.Name</h1>
            <p class="product-summary__subtitle">@Model.ShortDescription</p>

            <div class="product-rating-placeholder">
                <a href="#danh-gia">
                    Xem đánh giá từ khách đã mua hàng
                </a>
            </div>

            <section class="marketplace-seller-card">
                <div class="marketplace-seller-card__logo">
                    @if (!string.IsNullOrWhiteSpace(Model.StoreLogoUrl))
                    {
                        <img src="@Model.StoreLogoUrl"
                             alt="@Model.StoreName" />
                    }
                    else
                    {
                        <span>
                            @Model.StoreName.Substring(0, 1).ToUpperInvariant()
                        </span>
                    }
                </div>

                <div class="marketplace-seller-card__content">
                    <small>ĐƯỢC BÁN BỞI</small>
                    <strong>
                        @Model.StoreName
                        @if (Model.StoreIsVerified)
                        {
                            <i class="bi bi-patch-check-fill"
                               title="Người bán đã được xác minh"></i>
                        }
                    </strong>

                    <span>
                        @(string.IsNullOrWhiteSpace(Model.StoreLocation)
                            ? "Địa điểm đang cập nhật"
                            : Model.StoreLocation)
                        ·
                        @(Model.StoreReliabilityScore.HasValue
                            ? $"Uy tín {Model.StoreReliabilityScore:0.##}/100"
                            : "Chưa đủ dữ liệu uy tín")
                    </span>
                </div>
            </section>
            <div class="product-price-box">
                <div class="product-price-box__sale" data-sale-price>
                    @if (!Model.HasVariants && Model.SalePrice.HasValue)
                    {
                        @Model.SalePrice.Value.ToString("N0", culture)
                        <span>@Model.CurrencyCode</span>
                    }
                    else if (Model.HasVariants)
                    {
                        <span>Chọn phân loại để xem giá</span>
                    }
                    else
                    {
                        <span>Liên hệ để nhận giá</span>
                    }
                </div>

                <del data-list-price
                     hidden="@(!Model.ListPrice.HasValue ||
                               !Model.SalePrice.HasValue ||
                               Model.ListPrice <= Model.SalePrice)">
                    @Model.ListPrice?.ToString("N0", culture) @Model.CurrencyCode
                </del>
            </div>

            <dl class="product-quick-info">
                <div><dt>SKU</dt><dd data-product-sku>@Model.Sku</dd></div>
                @if (!string.IsNullOrWhiteSpace(Model.ModelNumber))
                {
                    <div><dt>Model</dt><dd>@Model.ModelNumber</dd></div>
                }
                <div><dt>Tồn kho</dt><dd data-product-stock>@Model.StockQuantity</dd></div>
                <div><dt>Bảo hành</dt><dd>@(Model.WarrantyMonths.HasValue ? $"{Model.WarrantyMonths} tháng" : "Theo chính sách")</dd></div>
            </dl>

            @if (Model.HasVariants)
            {
                <div class="variant-selector">
                    @foreach (var option in Model.Options)
                    {
                        <fieldset data-option-id="@option.Id">
                            <legend>@option.Name: <b data-selected-option-name>Chưa chọn</b></legend>
                            <div class="variant-selector__values">
                                @foreach (var value in option.Values)
                                {
                                    <button type="button"
                                            disabled="@(!value.IsAvailable)"
                                            data-option-value-id="@value.Id"
                                            data-option-value-name="@value.Value">
                                        @if (!string.IsNullOrWhiteSpace(value.ColorCode))
                                        {
                                            <i style="--option-color:@value.ColorCode"></i>
                                        }
                                        <span>@value.Value</span>
                                    </button>
                                }
                            </div>
                        </fieldset>
                    }
                </div>
            }

            <div class="quantity-control">
                <span>Số lượng</span>
                <div>
                    <button type="button" data-quantity-minus aria-label="Giảm số lượng">−</button>
                    <input type="number"
                           value="@Model.MinPurchaseQuantity"
                           min="@Model.MinPurchaseQuantity"
                           max="@(Model.MaxPurchaseQuantity ?? Math.Max(Model.StockQuantity, Model.MinPurchaseQuantity))"
                           data-quantity-input />
                    <button type="button" data-quantity-plus aria-label="Tăng số lượng">+</button>
                </div>
                <small>
                    Tối thiểu @Model.MinPurchaseQuantity
                    @if (Model.MaxPurchaseQuantity.HasValue)
                    {
                        <span>· Tối đa @Model.MaxPurchaseQuantity</span>
                    }
                </small>
            </div>

            <div class="product-purchase-actions">
                <button class="store-button store-button--primary store-button--large"
                        type="button"
                        disabled="@(!canBuySimpleProduct)"
                        data-add-to-cart>
                    @if (Model.HasVariants)
                    {
                        <span>Chọn phân loại</span>
                    }
                    else if (!Model.SalePrice.HasValue)
                    {
                        <span>Chưa có giá bán</span>
                    }
                    else if (Model.StockQuantity < Model.MinPurchaseQuantity)
                    {
                        <span>Tạm hết hàng</span>
                    }
                    else
                    {
                        <span>Thêm vào giỏ hàng</span>
                    }
                </button>
                <a class="store-button store-button--ghost store-button--large"
                   asp-controller="Home"
                   asp-action="Catalog">Tiếp tục xem hàng</a>
            </div>

            <p class="product-cart-feedback"
               data-cart-feedback
               aria-live="polite"></p>

            <div class="product-assurance">
                <span><b>Giá minh bạch</b><small>Theo lịch giá đang hiệu lực</small></span>
                <span><b>Tồn kho theo SKU</b><small>Cập nhật từ quản trị</small></span>
                <span><b>Thông tin rõ ràng</b><small>Nguồn gốc và nhà sản xuất</small></span>
            </div>
        </div>
    </div>
</section>

<section class="store-section product-information">
    <div class="store-container product-information__grid">
        <article>
            <span class="eyebrow">CHI TIẾT</span>
            <h2>Mô tả sản phẩm</h2>
            <div class="product-description">
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @foreach (var paragraph in Model.Description
                        .Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p>@paragraph</p>
                    }
                }
                else
                {
                    <p>Thông tin chi tiết đang được cập nhật.</p>
                }
            </div>
        </article>

        <aside>
            <h3>Thông tin hàng hóa</h3>
            <dl class="specification-list">
                <div><dt>Thương hiệu</dt><dd>@Model.BrandName</dd></div>
                <div><dt>Xuất xứ</dt><dd>@(Model.CountryOfOrigin ?? "Đang cập nhật")</dd></div>
                <div><dt>Nhà sản xuất</dt><dd>@(Model.ManufacturerName ?? "Đang cập nhật")</dd></div>
                <div><dt>Khối lượng</dt><dd>@(Model.Weight.HasValue ? $"{Model.Weight:N0} g" : "Đang cập nhật")</dd></div>
                <div><dt>Đơn vị bán</dt><dd>@Model.Unit</dd></div>

                @foreach (var item in Model.Specifications)
                {
                    <div><dt>@item.Name</dt><dd>@item.Value</dd></div>
                }
            </dl>
        </aside>
    </div>
</section>

@await Component.InvokeAsync(
    "ProductReviews",
    new { productId = Model.Id })

@if (Model.RelatedProducts.Count > 0)
{
    <section class="store-section store-section--tinted">
        <div class="store-container">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">CÙNG DANH MỤC</span>
                    <h2>Có thể bạn sẽ thích</h2>
                </div>
            </div>
            <div class="product-grid">
                @foreach (var item in Model.RelatedProducts)
                {
                    <partial name="_StoreProductCard" model="item" />
                }
            </div>
        </div>
    </section>
}

<script id="store-variant-data" type="application/json">@Html.Raw(variantJson)</script>

@section Scripts {
    <script src="~/store/js/product-details.js" asp-append-version="true"></script>
}
