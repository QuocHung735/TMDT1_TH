@using TMDT1_TH.Domain.Enums
@model TMDT1_TH.Areas.Admin.ViewModels.PromotionIndexViewModel
@{
    ViewData["Title"] = "Khuyến mãi";
    ViewData["Description"] =
        "Quản lý mã giảm giá, điều kiện đơn hàng, thời gian và thị trường áp dụng.";

    var modalClass =
        Model.OpenFormModal
            ? "is-open"
            : string.Empty;

    var modalHidden =
        Model.OpenFormModal
            ? "false"
            : "true";

    var formTitle =
        Model.Form.IsEdit
            ? "Chỉnh sửa khuyến mãi"
            : "Tạo khuyến mãi";
}

@section PageActions {
    <a class="btn btn-light"
       asp-controller="Pricing"
       asp-action="Index">
        <i class="bi bi-tags"></i>
        Lịch giá
    </a>

    <button class="btn btn-primary"
            type="button"
            data-modal-target="promotion-modal">
        <i class="bi bi-plus-lg"></i>
        Tạo khuyến mãi
    </button>
}

<section class="pricing-overview">
    <article class="pricing-overview__card">
        <span class="tone-purple">
            <i class="bi bi-ticket-perforated"></i>
        </span>
        <div>
            <small>Đang áp dụng</small>
            <strong>@Model.ActiveCount</strong>
            <em>mã còn hiệu lực</em>
        </div>
    </article>

    <article class="pricing-overview__card">
        <span class="tone-mint">
            <i class="bi bi-calendar-plus"></i>
        </span>
        <div>
            <small>Sắp áp dụng</small>
            <strong>@Model.UpcomingCount</strong>
            <em>chương trình đã lên lịch</em>
        </div>
    </article>

    <article class="pricing-overview__card">
        <span class="tone-amber">
            <i class="bi bi-calendar-x"></i>
        </span>
        <div>
            <small>Hết hạn</small>
            <strong>@Model.ExpiredCount</strong>
            <em>có thể dùng làm lịch sử</em>
        </div>
    </article>

    <article class="pricing-overview__card">
        <span class="tone-blue">
            <i class="bi bi-bag-check"></i>
        </span>
        <div>
            <small>Lượt đã dùng</small>
            <strong>@Model.TotalUsedCount</strong>
            <em>trên các đơn đã đặt</em>
        </div>
    </article>
</section>

<div class="tabs">
    <a asp-controller="Pricing"
       asp-action="Index">
        Lịch giá
    </a>
    <a class="is-active"
       asp-controller="Promotions"
       asp-action="Index">
        Khuyến mãi & mã giảm giá
    </a>
</div>

<section class="card panel">
    <form method="get"
          class="toolbar toolbar--wrap">
        <label class="field-search">
            <i class="bi bi-search"></i>
            <input type="search"
                   name="q"
                   value="@Model.Query"
                   placeholder="Tìm tên hoặc mã khuyến mãi..." />
        </label>

        <div class="toolbar__filters">
            <select asp-for="State"
                    class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="active">Đang áp dụng</option>
                <option value="upcoming">Sắp áp dụng</option>
                <option value="expired">Hết hạn</option>
                <option value="exhausted">Hết lượt</option>
                <option value="inactive">Tạm tắt</option>
            </select>

            <button class="btn btn-light"
                    type="submit">
                <i class="bi bi-funnel"></i>
                Lọc
            </button>

            <a class="btn btn-light"
               asp-action="Index">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Chương trình</th>
                    <th>Mức giảm</th>
                    <th>Đơn tối thiểu</th>
                    <th>Thị trường</th>
                    <th>Lượt dùng</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8">
                        <div class="empty-state">
                            <i class="bi bi-ticket-perforated"></i>
                            <strong>Chưa có khuyến mãi phù hợp</strong>
                            <p>
                                Tạo mã giảm giá đầu tiên hoặc thay đổi bộ lọc.
                            </p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    var toggleTitle =
                        item.IsActive
                            ? "Tạm tắt"
                            : "Kích hoạt";

                    var toggleIcon =
                        item.IsActive
                            ? "bi-pause-circle"
                            : "bi-play-circle";

                    <tr>
                        <td>
                            <div class="stacked-text">
                                <strong>@item.Name</strong>
                                <small>
                                    Mã:
                                    <b>@item.Code</b>
                                </small>
                            </div>
                        </td>
                        <td>
                            <strong class="sale-price">
                                @item.DiscountText
                            </strong>
                        </td>
                        <td>@item.MinimumOrderText</td>
                        <td>
                            <span class="market-chip">
                                <i class="bi bi-geo-alt"></i>
                                @item.Markets
                            </span>
                        </td>
                        <td>@item.UsageText</td>
                        <td>@item.Period</td>
                        <td>
                            <span class="status-pill @UiStatus.Class(item.Status)">
                                @item.Status
                            </span>
                        </td>
                        <td class="table-actions">
                            <a class="icon-btn"
                               asp-action="Index"
                               asp-route-editId="@item.Id"
                               title="Chỉnh sửa">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="ToggleStatus"
                                  method="post"
                                  class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />
                                <button class="icon-btn"
                                        type="submit"
                                        title="@toggleTitle">
                                    <i class="bi @toggleIcon"></i>
                                </button>
                            </form>

                            <form asp-action="Delete"
                                  method="post"
                                  class="inline-form"
                                  onsubmit="return confirm('Xóa khuyến mãi này? Khuyến mãi đã có lượt dùng chỉ được tạm tắt.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />
                                <button class="icon-btn icon-btn--danger"
                                        type="submit"
                                        title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <span>
            Hiển thị @Model.Items.Count chương trình
        </span>
    </div>
</section>

<div class="modal modal--wide @modalClass"
     id="promotion-modal"
     aria-hidden="@modalHidden">
    <div class="modal__backdrop"
         data-modal-close></div>

    <div class="modal__dialog">
        <form asp-action="Save"
              method="post">
            @Html.AntiForgeryToken()

            <input asp-for="Form.Id"
                   type="hidden" />
            <input asp-for="Query"
                   type="hidden" />
            <input asp-for="State"
                   type="hidden" />

            <div class="modal__header">
                <div>
                    <h2>@formTitle</h2>
                    <p>
                        Thiết lập mã, mức giảm, điều kiện và thị trường áp dụng.
                    </p>
                </div>

                <button type="button"
                        class="icon-btn"
                        data-modal-close>
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal__body form-stack">
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-grid form-grid--2">
                    <label class="form-field">
                        <span>
                            Tên chương trình <em>*</em>
                        </span>
                        <input asp-for="Form.Name"
                               maxlength="200"
                               placeholder="Ví dụ: Khuyến mãi cuối tháng" />
                        <span asp-validation-for="Form.Name"
                              class="field-error"></span>
                    </label>

                    <label class="form-field">
                        <span>
                            Mã khuyến mãi <em>*</em>
                        </span>
                        <input asp-for="Form.Code"
                               maxlength="50"
                               data-promotion-code
                               placeholder="Ví dụ: MAYHOME20" />
                        <small>
                            Tự động chuyển thành chữ hoa, không dùng khoảng trắng.
                        </small>
                        <span asp-validation-for="Form.Code"
                              class="field-error"></span>
                    </label>
                </div>

                <div class="form-grid form-grid--2">
                    <label class="form-field">
                        <span>
                            Loại giảm <em>*</em>
                        </span>
                        <select asp-for="Form.DiscountType"
                                data-discount-type>
                            <option value="@((int)PromotionDiscountType.Percentage)">
                                Giảm theo phần trăm
                            </option>
                            <option value="@((int)PromotionDiscountType.FixedAmount)">
                                Giảm theo số tiền
                            </option>
                        </select>
                    </label>

                    <label class="form-field price-field">
                        <span>
                            Giá trị giảm <em>*</em>
                        </span>
                        <div>
                            <input asp-for="Form.DiscountValue"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   data-discount-value />
                            <i data-discount-unit>%</i>
                        </div>
                        <span asp-validation-for="Form.DiscountValue"
                              class="field-error"></span>
                    </label>
                </div>

                <div class="form-grid form-grid--3">
                    <label class="form-field price-field"
                           data-max-discount-field>
                        <span>Mức giảm tối đa</span>
                        <div>
                            <input asp-for="Form.MaximumDiscountAmount"
                                   type="number"
                                   min="1"
                                   step="1" />
                            <i>₫</i>
                        </div>
                        <small>
                            Chỉ dùng khi giảm theo phần trăm.
                        </small>
                        <span asp-validation-for="Form.MaximumDiscountAmount"
                              class="field-error"></span>
                    </label>

                    <label class="form-field price-field">
                        <span>Giá trị đơn tối thiểu</span>
                        <div>
                            <input asp-for="Form.MinimumOrderAmount"
                                   type="number"
                                   min="0"
                                   step="1" />
                            <i>₫</i>
                        </div>
                        <span asp-validation-for="Form.MinimumOrderAmount"
                              class="field-error"></span>
                    </label>

                    <label class="form-field">
                        <span>Giới hạn lượt sử dụng</span>
                        <input asp-for="Form.UsageLimit"
                               type="number"
                               min="1"
                               step="1"
                               placeholder="Không giới hạn" />
                        <span asp-validation-for="Form.UsageLimit"
                              class="field-error"></span>
                    </label>
                </div>

                <div class="schedule-box">
                    <div class="schedule-box__head">
                        <strong>Thời gian áp dụng</strong>
                    </div>

                    <div class="form-grid form-grid--2">
                        <label class="form-field">
                            <span>Bắt đầu <em>*</em></span>
                            <input asp-for="Form.StartsAt"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="Form.StartsAt"
                                  class="field-error"></span>
                        </label>

                        <label class="form-field">
                            <span>Kết thúc <em>*</em></span>
                            <input asp-for="Form.EndsAt"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="Form.EndsAt"
                                  class="field-error"></span>
                        </label>
                    </div>
                </div>

                <section class="promotion-market-box">
                    <strong>Thị trường áp dụng <em>*</em></strong>
                    <p>
                        Có thể chọn một hoặc nhiều thị trường.
                    </p>

                    <div class="promotion-market-grid">
                    @foreach (var market in Model.Form.MarketOptions)
                    {
                        var marketId =
                            int.Parse(market.Value);

                        <label class="promotion-market-option">
                            @if (Model.Form.MarketIds.Contains(marketId))
                            {
                                <input type="checkbox"
                                       name="Form.MarketIds"
                                       value="@market.Value"
                                       checked />
                            }
                            else
                            {
                                <input type="checkbox"
                                       name="Form.MarketIds"
                                       value="@market.Value" />
                            }
                            <span>@market.Text</span>
                        </label>
                    }
                    </div>

                    <span asp-validation-for="Form.MarketIds"
                          class="field-error"></span>
                </section>

                <label class="switch-row switch-row--border">
                    <span>
                        <strong>Kích hoạt chương trình</strong>
                        <small>
                            Chương trình tắt sẽ không được khách sử dụng.
                        </small>
                    </span>
                    <input asp-for="Form.IsActive" />
                    <i></i>
                </label>

                <label class="form-field">
                    <span>Mô tả</span>
                    <textarea asp-for="Form.Description"
                              rows="3"
                              maxlength="1000"
                              placeholder="Nội dung và điều kiện bổ sung..."></textarea>
                    <span asp-validation-for="Form.Description"
                          class="field-error"></span>
                </label>
            </div>

            <div class="modal__footer">
                <button type="button"
                        class="btn btn-light"
                        data-modal-close>
                    Hủy
                </button>

                <button class="btn btn-primary"
                        type="submit">
                    <i class="bi bi-check2"></i>
                    Lưu khuyến mãi
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .tabs a {
        display: inline-flex;
        align-items: center;
        padding: 10px 14px;
        color: inherit;
        text-decoration: none;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .tabs a.is-active {
        color: #6956df;
        background: #f0edff;
    }

    .promotion-market-box {
        padding: 15px;
        border: 1px solid #e3dff0;
        border-radius: 13px;
        background: #faf9ff;
    }

    .promotion-market-box > strong {
        display: block;
        font-size: 11px;
    }

    .promotion-market-box > p {
        margin: 4px 0 12px;
        color: #77718c;
        font-size: 9px;
    }

    .promotion-market-grid {
        display: grid;
        grid-template-columns:
            repeat(auto-fit, minmax(180px, 1fr));
        gap: 8px;
    }

    .promotion-market-option {
        display: flex;
        align-items: center;
        min-height: 42px;
        padding: 9px 11px;
        gap: 8px;
        cursor: pointer;
        background: #fff;
        border: 1px solid #ddd8ec;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 600;
    }

    .promotion-market-option:has(input:checked) {
        color: #5d4ed4;
        background: #f0edff;
        border-color: #9b8df5;
    }

    .promotion-market-option input {
        width: 16px;
        height: 16px;
        accent-color: #7c69ee;
    }
</style>

@section Scripts {
    <script>
        (() => {
            const code =
                document.querySelector(
                    "[data-promotion-code]");

            const type =
                document.querySelector(
                    "[data-discount-type]");

            const unit =
                document.querySelector(
                    "[data-discount-unit]");

            const maxField =
                document.querySelector(
                    "[data-max-discount-field]");

            const updateType = () => {
                const percentage =
                    type?.value ===
                    "@((int)PromotionDiscountType.Percentage)";

                if (unit) {
                    unit.textContent =
                        percentage
                            ? "%"
                            : "₫";
                }

                if (maxField) {
                    maxField.hidden =
                        !percentage;

                    const input =
                        maxField.querySelector(
                            "input");

                    if (input) {
                        input.disabled =
                            !percentage;
                    }
                }
            };

            code?.addEventListener(
                "input",
                () => {
                    code.value =
                        code.value
                            .toUpperCase()
                            .replace(
                                /[^A-Z0-9_-]/g,
                                "");
                });

            type?.addEventListener(
                "change",
                updateType);

            updateType();
        })();
    </script>
}
