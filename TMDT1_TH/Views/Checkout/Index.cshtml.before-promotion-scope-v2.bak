@using System.Globalization
@model TMDT1_TH.ViewModels.Storefront.StoreCheckoutViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Thanh toán";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var invariant = CultureInfo.InvariantCulture;
}

<section class="checkout-head">
    <div class="store-container">
        <span class="eyebrow">THANH TOÁN</span>
        <h1>Thông tin nhận hàng</h1>
        <p>
            Giá, tồn kho và phí vận chuyển sẽ được kiểm tra lại
            khi bạn xác nhận đặt hàng.
        </p>
    </div>
</section>

<section class="store-section checkout-page">
    <div class="store-container checkout-layout">
        <form asp-controller="Checkout"
              asp-action="PlaceOrder"
              method="post"
              class="checkout-form"
              data-shipping-checkout
               data-vn-address-form
               data-vn-address-required="true"
              data-subtotal="@Model.Subtotal.ToString("0.##", invariant)"
              data-currency="@Model.CurrencyCode"
               data-promotion-url="@Url.Action("Preview", "PromotionCheckout")">
            <div asp-validation-summary="ModelOnly"
                 class="checkout-validation"></div>

            <section class="checkout-card">
                <div class="checkout-card__heading">
                    <span>1</span>
                    <div>
                        <h2>Người nhận</h2>
                        <p>Thông tin dùng để liên hệ khi giao hàng.</p>
                    </div>
                </div>

                <div class="checkout-fields checkout-fields--two">
                    <label>
                        <span>@Html.DisplayNameFor(x => x.CustomerName)</span>
                        <input asp-for="CustomerName"
                               autocomplete="name"
                               maxlength="150" />
                        <small asp-validation-for="CustomerName"></small>
                    </label>

                    <label>
                        <span>@Html.DisplayNameFor(x => x.CustomerPhone)</span>
                        <input asp-for="CustomerPhone"
                               autocomplete="tel"
                               inputmode="tel"
                               maxlength="30" />
                        <small asp-validation-for="CustomerPhone"></small>
                    </label>

                    <label class="checkout-field--full">
                        <span>@Html.DisplayNameFor(x => x.CustomerEmail)</span>
                        <input asp-for="CustomerEmail"
                               autocomplete="email"
                               maxlength="180"
                               placeholder="Không bắt buộc" />
                        <small asp-validation-for="CustomerEmail"></small>
                    </label>
                </div>
            </section>

            <section class="checkout-card">
                <div class="checkout-card__heading">
                    <span>2</span>
                    <div>
                        <h2>Địa chỉ giao hàng</h2>
                        <p>
                            Địa chỉ trong hồ sơ đã được điền sẵn
                            khi có dữ liệu.
                        </p>
                    </div>
                </div>

                <div class="checkout-fields checkout-fields--two">
                    <label>
                        <span>@Html.DisplayNameFor(x => x.Province)</span>
                        <select asp-for="Province"
                                required
                                autocomplete="address-level1"
                                data-vn-province
                                data-current-value="@Model.Province">
                            <option value="">Đang tải tỉnh/thành phố...</option>
                        </select>
                        <small asp-validation-for="Province"></small>
                    </label>

                    <input asp-for="District"
                           type="hidden"
                           data-vn-district />

                    <label>
                        <span>@Html.DisplayNameFor(x => x.Ward)</span>
                        <select asp-for="Ward"
                                required
                                autocomplete="address-level2"
                                data-vn-ward
                                data-current-value="@Model.Ward">
                            <option value="">Chọn tỉnh/thành phố trước</option>
                        </select>
                        <small asp-validation-for="Ward"></small>
                    </label>

                    <div class="checkout-field--full vn-address-status"
                         data-vn-address-status
                         hidden></div>

                    <label>
                        <span>@Html.DisplayNameFor(x => x.AddressLine)</span>
                        <input asp-for="AddressLine"
                               autocomplete="street-address"
                               maxlength="500"
                               placeholder="Số nhà, tên đường..." />
                        <small asp-validation-for="AddressLine"></small>
                    </label>

                    <label class="checkout-field--full">
                        <span>@Html.DisplayNameFor(x => x.CustomerNote)</span>
                        <textarea asp-for="CustomerNote"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Ví dụ: Gọi trước khi giao hàng"></textarea>
                        <small asp-validation-for="CustomerNote"></small>
                    </label>
                </div>
            </section>

            <section class="checkout-card">
                <div class="checkout-card__heading">
                    <span>3</span>
                    <div>
                        <h2>Phương thức giao hàng</h2>
                        <p>
                            Phí được lấy trực tiếp từ cấu hình
                            của đơn vị giao nhận.
                        </p>
                    </div>
                </div>

                <div class="shipping-option-list">
                    @if (Model.ShippingOptions.Count == 0)
                    {
                        <div class="shipping-option-empty">
                            Chưa có phương thức giao hàng đang hoạt động.
                            Vui lòng liên hệ cửa hàng.
                        </div>
                    }
                    else
                    {
                        @foreach (var option in Model.ShippingOptions)
                        {
                            <label class="shipping-option @(Model.ShippingServiceId == option.Id ? "is-selected" : "")"
                                   data-shipping-option>
                                <input asp-for="ShippingServiceId"
                                       type="radio"
                                       value="@option.Id"
                                       data-shipping-radio
                                       data-shipping-fee="@option.Fee.ToString("0.##", invariant)" />

                                <span class="shipping-option__mark">
                                    <i class="bi bi-truck"></i>
                                </span>

                                <span class="shipping-option__content">
                                    <b>@option.ServiceName</b>
                                    <small>
                                        @option.CarrierName ·
                                        Dự kiến @option.EstimatedText
                                    </small>
                                    @if (!string.IsNullOrWhiteSpace(option.Description))
                                    {
                                        <em>@option.Description</em>
                                    }
                                </span>

                                <strong>
                                    @(option.Fee == 0
                                        ? "Miễn phí"
                                        : $"{option.Fee.ToString("N0", culture)} {Model.CurrencyCode}")
                                </strong>
                            </label>
                        }
                    }
                </div>

                <small asp-validation-for="ShippingServiceId"
                       class="shipping-option-validation"></small>
            </section>

            <section class="checkout-card">
                <div class="checkout-card__heading">
                    <span>4</span>
                    <div>
                        <h2>Phương thức thanh toán</h2>
                        <p>Bước này hỗ trợ thanh toán khi nhận hàng.</p>
                    </div>
                </div>

                <label class="payment-method is-selected">
                    <input type="radio"
                           checked
                           disabled />
                    <span>
                        <b>Thanh toán khi nhận hàng</b>
                        <small>
                            Thanh toán trực tiếp cho đơn vị giao hàng.
                        </small>
                    </span>
                </label>
            </section>

            <button class="store-button store-button--primary store-button--large store-button--full"
                    type="submit"
                    disabled="@(Model.ShippingOptions.Count == 0)">
                Xác nhận đặt hàng
            </button>

            <p class="checkout-submit-note">
                Bằng việc đặt hàng, bạn xác nhận thông tin người nhận
                và phương thức giao hàng là chính xác.
            </p>
        </form>

        <aside class="checkout-summary">
            <h2>Đơn hàng của bạn</h2>

            <div class="checkout-items">
                @foreach (var item in Model.Items)
                {
                    <article class="checkout-item">
                        <div class="checkout-item__image">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName" />
                            }
                            else
                            {
                                <span>Mây Home</span>
                            }
                        </div>

                        <div>
                            <b>@item.ProductName</b>
                            @if (!string.IsNullOrWhiteSpace(item.VariantName))
                            {
                                <small>@item.VariantName</small>
                            }
                            <small>@item.Sku · SL @item.Quantity</small>
                        </div>

                        <strong>
                            @item.LineTotal.ToString("N0", culture)
                            @Model.CurrencyCode
                        </strong>
                    </article>
                }
            </div>

            <section class="checkout-promotion-box">
                <div>
                    <strong>Mã khuyến mãi</strong>
                    <small>
                        Nhập mã do Mây Home phát hành. Mỗi đơn chỉ áp dụng một mã.
                    </small>
                </div>

                <div class="checkout-promotion-box__input">
                    <input asp-for="PromotionCode"
                           maxlength="50"
                           autocomplete="off"
                           data-checkout-promotion-code
                           placeholder="Ví dụ: MAYHOME20" />

                    <button type="button"
                            data-apply-promotion>
                        Áp dụng
                    </button>
                </div>

                <small asp-validation-for="PromotionCode"
                       class="field-error"></small>

                <small class="checkout-promotion-message"
                       data-promotion-message></small>
            </section>
            <dl class="checkout-totals">
                <div>
                    <dt>Số lượng</dt>
                    <dd>@Model.TotalQuantity sản phẩm</dd>
                </div>
                <div>
                    <dt>Tạm tính</dt>
                    <dd>
                        @Model.Subtotal.ToString("N0", culture)
                        @Model.CurrencyCode
                    </dd>
                </div>
                <div>
                    <dt>Phí vận chuyển</dt>
                    <dd data-checkout-shipping-fee>
                        @(Model.ShippingFee == 0
                            ? "Miễn phí"
                            : $"{Model.ShippingFee.ToString("N0", culture)} {Model.CurrencyCode}")
                    </dd>
                </div>
                <div>
                    <dt>Khuyến mãi</dt>
                    <dd data-checkout-discount
                        data-discount="@Model.DiscountAmount.ToString("0.##", invariant)">
                        @(Model.DiscountAmount > 0
                            ? $"- {Model.DiscountAmount.ToString("N0", culture)} {Model.CurrencyCode}"
                            : $"0 {Model.CurrencyCode}")
                    </dd>
                </div>
            </dl>

            <div class="checkout-total">
                <span>Tổng thanh toán</span>
                <strong data-checkout-total>
                    @Model.TotalAmount.ToString("N0", culture)
                    @Model.CurrencyCode
                </strong>
            </div>

            <a class="checkout-back-link"
               asp-controller="Cart"
               asp-action="Index">
                ← Quay lại giỏ hàng
            </a>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/store/js/vietnam-address.js"
            asp-append-version="true"></script>
    <script>
        (() => {
            const form =
                document.querySelector("[data-shipping-checkout
               data-vn-address-form
               data-vn-address-required="true"]");

            if (!form) return;

            const subtotal =
                Number(form.dataset.subtotal || 0);

            const currency =
                form.dataset.currency || "VND";

            const feeOutput =
                document.querySelector(
                    "[data-checkout-shipping-fee]");

            const totalOutput =
                document.querySelector(
                    "[data-checkout-total]");

            const formatMoney = value =>
                new Intl.NumberFormat("vi-VN")
                    .format(value);

            const update = () => {
                const selected =
                    form.querySelector(
                        "[data-shipping-radio]:checked");

                const fee =
                    Number(
                        selected?.dataset.shippingFee || 0);

                form.querySelectorAll(
                    "[data-shipping-option]")
                    .forEach(option => {
                        const radio =
                            option.querySelector(
                                "[data-shipping-radio]");

                        option.classList.toggle(
                            "is-selected",
                            radio?.checked === true);
                    });

                if (feeOutput) {
                    feeOutput.textContent =
                        fee === 0
                            ? "Miễn phí"
                            : `${formatMoney(fee)} ${currency}`;
                }

                if (totalOutput) {
                    totalOutput.textContent =
                        `${formatMoney(subtotal + fee)} ${currency}`;
                }
            };

            form.querySelectorAll(
                "[data-shipping-radio]")
                .forEach(radio =>
                    radio.addEventListener(
                        "change",
                        update));

            update();
        })();
    </script>
    <script src="~/store/js/checkout-promotions.js" asp-append-version="true"></script>
}



<style>
    .checkout-promotion-box {
        margin-bottom: 16px;
        padding: 14px;
        background: #faf9ff;
        border: 1px solid #e3def7;
        border-radius: 13px;
    }

    .checkout-promotion-box strong,
    .checkout-promotion-box small {
        display: block;
    }

    .checkout-promotion-box small {
        margin-top: 3px;
        color: #756f87;
        line-height: 1.5;
    }

    .checkout-promotion-box__input {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        margin-top: 11px;
    }

    .checkout-promotion-box__input input {
        min-width: 0;
        height: 42px;
        padding: 0 12px;
        text-transform: uppercase;
        border: 1px solid #dcd6ec;
        border-radius: 10px;
    }

    .checkout-promotion-box__input button {
        padding: 0 14px;
        color: #fff;
        cursor: pointer;
        background: #6d58dd;
        border: 0;
        border-radius: 10px;
        font-weight: 700;
    }

    .checkout-promotion-message.is-success {
        color: #237a4d;
    }

    .checkout-promotion-message.is-error {
        color: #b53d54;
    }
</style>
