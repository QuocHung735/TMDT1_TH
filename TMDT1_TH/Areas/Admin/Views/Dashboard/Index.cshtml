@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    ViewData["Description"] = "Theo dõi tình trạng sản phẩm, giá và các việc cần xử lý hôm nay.";
}

@section PageActions {
    <button type="button" class="btn btn-light"><i class="bi bi-download"></i> Xuất báo cáo</button>
    <a class="btn btn-primary" asp-area="Admin" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
}

<section class="welcome-banner">
    <div>
        <span class="eyebrow"><i class="bi bi-stars"></i> Chào buổi sáng, Quốc Hưng</span>
        <h2>Cửa hàng đang vận hành ổn định</h2>
        <p>Bạn có 24 sản phẩm sắp hết hàng và 18 lịch giá đang chờ áp dụng.</p>
    </div>
    <div class="welcome-banner__art" aria-hidden="true">
        <span></span><span></span><span></span>
        <i class="bi bi-bag-heart"></i>
    </div>
</section>

<section class="metric-grid">
    @foreach (var metric in Model.Metrics)
    {
        <article class="metric-card card">
            <div class="metric-card__icon tone-@metric.Tone"><i class="bi @metric.Icon"></i></div>
            <div class="metric-card__body">
                <span>@metric.Label</span>
                <div class="metric-card__value"><strong>@metric.Value</strong><em>@metric.Change</em></div>
                <small>@metric.Caption</small>
            </div>
        </article>
    }
</section>

<div class="dashboard-grid dashboard-grid--wide">
    <section class="card panel">
        <div class="panel__header">
            <div><h2>Sản phẩm gần đây</h2><p>Cập nhật mới nhất trong kho sản phẩm.</p></div>
            <a class="text-link" asp-area="Admin" asp-controller="Products" asp-action="Index">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th></tr></thead>
                <tbody>
                @foreach (var item in Model.RecentProducts)
                {
                    <tr>
                        <td><div class="product-cell"><span class="product-thumb tone-@item.Tone">@item.Initials</span><span><strong>@item.Name</strong><small>@item.Sku</small></span></div></td>
                        <td>@item.Category</td><td><strong>@item.Price</strong></td><td>@item.Stock</td>
                        <td><span class="status-pill @UiStatus.Class(item.Status)">@item.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card panel">
        <div class="panel__header"><div><h2>Hoạt động gần đây</h2><p>Nhật ký thao tác quan trọng.</p></div><button class="icon-btn"><i class="bi bi-three-dots"></i></button></div>
        <div class="activity-list">
            @foreach (var activity in Model.Activities)
            {
                <article class="activity-item">
                    <span class="activity-item__icon tone-@activity.Tone"><i class="bi @activity.Icon"></i></span>
                    <div><strong>@activity.Title</strong><p>@activity.Description</p><small>@activity.Time</small></div>
                </article>
            }
        </div>
    </section>
</div>

<div class="dashboard-grid">
    <section class="card panel">
        <div class="panel__header"><div><h2>Lịch giá sắp áp dụng</h2><p>Chuẩn bị kiểm tra trước khi giá có hiệu lực.</p></div><a class="text-link" asp-area="Admin" asp-controller="Pricing" asp-action="Index">Quản lý giá</a></div>
        <div class="compact-list">
            @foreach (var alert in Model.PriceAlerts)
            {
                <div class="compact-list__item">
                    <span class="date-tile"><strong>@alert.EffectiveDate.Substring(0, 2)</strong><small>Thg 07</small></span>
                    <div><strong>@alert.Product</strong><p>@alert.Market · @alert.PriceType</p></div>
                    <span class="status-pill status-scheduled">@alert.Status</span>
                </div>
            }
        </div>
    </section>

    <section class="card panel stock-panel">
        <div class="panel__header"><div><h2>Sức khỏe tồn kho</h2><p>Phân bố theo mức tồn hiện tại.</p></div><span class="panel-badge">1.248 SKU</span></div>
        <div class="donut-layout">
            <div class="donut-chart"><div><strong>92%</strong><span>Sẵn sàng bán</span></div></div>
            <div class="legend-list">
                <span><i class="legend-dot legend-dot--good"></i> Còn hàng <strong>1.148</strong></span>
                <span><i class="legend-dot legend-dot--warning"></i> Sắp hết <strong>76</strong></span>
                <span><i class="legend-dot legend-dot--danger"></i> Hết hàng <strong>24</strong></span>
            </div>
        </div>
    </section>
</div>
