@model StoresViewModel
@{
    ViewData["Title"] = "Quản lý cửa hàng";
    ViewData["Description"] =
        "Quản lý người bán, trạng thái xác minh và sản phẩm thuộc từng cửa hàng.";
}
@section PageActions {
    <a class="btn btn-light"
       asp-controller="Products"
       asp-action="Index">
        <i class="bi bi-box-seam"></i>
        Sản phẩm
    </a>
}

<section class="segmented-stats">
    <button class="is-active" type="button">
        <strong>@Model.TotalCount</strong>
        <span>Tất cả cửa hàng</span>
    </button>
    <button type="button">
        <strong>@Model.ActiveCount</strong>
        <span>Đang hoạt động</span>
    </button>
    <button type="button">
        <strong>@Model.VerifiedCount</strong>
        <span>Đã xác minh</span>
    </button>
    <button type="button">
        <strong>@Model.ProductCount</strong>
        <span>Sản phẩm đã gắn</span>
    </button>
</section>

<div class="editor-layout marketplace-editor">
    <section class="card panel">
        <div class="panel__heading">
            <div>
                <span class="eyebrow">NGƯỜI BÁN</span>
                <h2>
                    @(Model.Form.IsEdit
                        ? "Chỉnh sửa cửa hàng"
                        : "Thêm cửa hàng")
                </h2>
            </div>
        </div>

        <form asp-action="@(Model.Form.IsEdit ? "Edit" : "Create")"
              method="post"
              class="form-stack"
              style="padding:20px">
            @Html.AntiForgeryToken()
            <input asp-for="Form.Id" type="hidden" />

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <label class="form-field">
                <span>Tên cửa hàng <em>*</em></span>
                <input asp-for="Form.Name"
                       maxlength="200"
                       placeholder="Ví dụ: Gia Dụng An Nhiên" />
                <span asp-validation-for="Form.Name"></span>
            </label>

            <label class="form-field">
                <span>Đường dẫn</span>
                <input asp-for="Form.Slug"
                       maxlength="220"
                       placeholder="Tự động tạo từ tên cửa hàng" />
                <small>
                    Để trống để hệ thống tự tạo đường dẫn duy nhất.
                </small>
                <span asp-validation-for="Form.Slug"></span>
            </label>

            <label class="form-field">
                <span>Mô tả</span>
                <textarea asp-for="Form.Description"
                          maxlength="1200"
                          rows="4"
                          placeholder="Giới thiệu ngắn về cửa hàng và nhóm sản phẩm kinh doanh."></textarea>
                <span asp-validation-for="Form.Description"></span>
            </label>

            <label class="form-field">
                <span>Logo URL</span>
                <input asp-for="Form.LogoUrl"
                       maxlength="500"
                       placeholder="/images/stores/logo.webp" />
                <span asp-validation-for="Form.LogoUrl"></span>
            </label>

            <div class="form-grid form-grid--2">
                <label class="form-field">
                    <span>Email liên hệ</span>
                    <input asp-for="Form.ContactEmail"
                           type="email"
                           maxlength="256" />
                    <span asp-validation-for="Form.ContactEmail"></span>
                </label>

                <label class="form-field">
                    <span>Điện thoại</span>
                    <input asp-for="Form.PhoneNumber"
                           maxlength="30" />
                    <span asp-validation-for="Form.PhoneNumber"></span>
                </label>
            </div>

            <label class="form-field">
                <span>Địa chỉ</span>
                <input asp-for="Form.AddressLine"
                       maxlength="400" />
            </label>

            <div class="form-grid form-grid--2">
                <label class="form-field">
                    <span>Phường / xã</span>
                    <input asp-for="Form.Ward"
                           maxlength="150" />
                </label>

                <label class="form-field">
                    <span>Quận / huyện</span>
                    <input asp-for="Form.District"
                           maxlength="150" />
                </label>
            </div>

            <div class="form-grid form-grid--2">
                <label class="form-field">
                    <span>Tỉnh / thành phố</span>
                    <input asp-for="Form.Province"
                           maxlength="150" />
                </label>

                <label class="form-field">
                    <span>Thứ tự hiển thị</span>
                    <input asp-for="Form.DisplayOrder"
                           type="number"
                           min="0"
                           max="9999" />
                </label>
            </div>

            <label class="switch-row switch-row--border">
                <span>
                    <strong>Đang hoạt động</strong>
                    <small>
                        Sản phẩm của cửa hàng bị ẩn khỏi website
                        khi cửa hàng ngừng hoạt động.
                    </small>
                </span>
                <input asp-for="Form.IsActive" />
                <i></i>
            </label>

            <label class="switch-row switch-row--border">
                <span>
                    <strong>Đã xác minh</strong>
                    <small>
                        Chỉ Admin được cấp dấu xác minh người bán.
                    </small>
                </span>
                <input asp-for="Form.IsVerified" />
                <i></i>
            </label>

            <div class="row-actions">
                @if (Model.Form.IsEdit)
                {
                    <a class="btn btn-light"
                       asp-action="Index">
                        Hủy chỉnh sửa
                    </a>
                }

                <button class="btn btn-primary"
                        type="submit">
                    <i class="bi bi-check2"></i>
                    @(Model.Form.IsEdit
                        ? "Lưu thay đổi"
                        : "Tạo cửa hàng")
                </button>
            </div>
        </form>
    </section>

    <section class="card panel">
        <form method="get"
              class="toolbar toolbar--wrap">
            <label class="field-search">
                <i class="bi bi-search"></i>
                <input type="search"
                       name="q"
                       value="@Model.Query"
                       placeholder="Tìm tên, slug hoặc tỉnh thành..." />
            </label>

            <div class="toolbar__filters">
                <select class="form-select"
                        name="active">
                    <option value="">Tất cả trạng thái</option>
                    @if (Model.Active == true)
                    {
                        <option value="true" selected>
                            Đang hoạt động
                        </option>
                    }
                    else
                    {
                        <option value="true">
                            Đang hoạt động
                        </option>
                    }

                    @if (Model.Active == false)
                    {
                        <option value="false" selected>
                            Đã ẩn
                        </option>
                    }
                    else
                    {
                        <option value="false">
                            Đã ẩn
                        </option>
                    }
                </select>

                <button class="btn btn-light"
                        type="submit">
                    <i class="bi bi-funnel"></i>
                    Lọc
                </button>

                <a class="btn btn-light"
                   asp-action="Index">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Cửa hàng</th>
                        <th>Địa điểm / liên hệ</th>
                        <th>Sản phẩm</th>
                        <th>Uy tín</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6">
                            <div style="padding:42px;text-align:center">
                                Chưa có cửa hàng phù hợp.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="stacked-text">
                                    <strong>
                                        @item.Name
                                        @if (item.IsVerified)
                                        {
                                            <i class="bi bi-patch-check-fill"
                                               title="Đã xác minh"
                                               style="color:#76539b"></i>
                                        }
                                    </strong>
                                    <small>@item.Slug</small>
                                </div>
                            </td>
                            <td>
                                <div class="stacked-text">
                                    <strong>@item.Location</strong>
                                    <small>@item.Contact</small>
                                </div>
                            </td>
                            <td>
                                <strong>@item.ProductCount</strong>
                            </td>
                            <td>
                                <div class="stacked-text">
                                    <strong>@item.ReliabilityLabel</strong>
                                    <small>
                                        @(item.ReliabilityScore.HasValue
                                            ? $"{item.ReliabilityScore:0.##}/100"
                                            : "Sẽ tính từ lịch sử đơn hàng")
                                    </small>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge @(item.IsActive ? "is-active" : "is-muted")">
                                    @(item.IsActive
                                        ? "Đang hoạt động"
                                        : "Đã ẩn")
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a class="btn btn-light btn-sm"
                                       asp-action="Index"
                                       asp-route-editId="@item.Id">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="Toggle"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />
                                        <button class="btn btn-light btn-sm"
                                                type="submit"
                                                title="Đổi trạng thái">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </form>

                                    @if (item.CanDelete)
                                    {
                                        <form asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('Xóa cửa hàng này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />
                                            <button class="btn btn-light btn-sm"
                                                    type="submit">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
