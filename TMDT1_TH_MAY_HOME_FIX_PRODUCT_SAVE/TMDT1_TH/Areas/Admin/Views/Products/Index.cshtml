@using TMDT1_TH.Domain.Enums
@model ProductsViewModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    ViewData["Description"] = "Quản lý sản phẩm đồ gia dụng, biến thể, tồn kho và bảng giá từ dữ liệu thật.";
}
@section PageActions {
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
}

<section class="segmented-stats">
    <button class="is-active" type="button"><strong>@Model.TotalCount</strong><span>Tất cả</span></button>
    <button type="button"><strong>@Model.ActiveCount</strong><span>Đang bán</span></button>
    <button type="button"><strong>@Model.DraftCount</strong><span>Bản nháp</span></button>
    <button type="button"><strong>@Model.OutOfStockCount</strong><span>Hết hàng</span></button>
</section>

<section class="card panel">
    <form method="get" class="toolbar toolbar--wrap">
        <label class="field-search">
            <i class="bi bi-search"></i>
            <input type="search" name="q" value="@Model.Query" placeholder="Tìm tên sản phẩm hoặc SKU..." />
        </label>
        <div class="toolbar__filters">
            <select class="form-select" name="categoryId" asp-items="Model.CategoryOptions">
                <option value="">Tất cả danh mục</option>
            </select>
            <select class="form-select" name="brandId" asp-items="Model.BrandOptions">
                <option value="">Tất cả thương hiệu</option>
            </select>
            <select class="form-select" asp-for="Status">
                <option value="">Tất cả trạng thái</option>
                <option value="2">Đang bán</option>
                <option value="1">Bản nháp</option>
                <option value="3">Tạm ẩn</option>
                <option value="4">Hết hàng</option>
                <option value="5">Ngừng kinh doanh</option>
            </select>
            <button class="btn btn-light" type="submit"><i class="bi bi-funnel"></i> Lọc</button>
            <a class="btn btn-light" asp-action="Index" title="Xóa bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>

    <div class="table-wrap">
        <table class="data-table" id="product-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Danh mục / Thương hiệu</th>
                    <th>Biến thể</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div style="padding:42px;text-align:center;color:var(--text-secondary)">
                            <i class="bi bi-box-seam" style="font-size:32px"></i>
                            <p style="margin:10px 0 16px">Chưa có sản phẩm phù hợp.</p>
                            <a class="btn btn-primary btn-sm" asp-action="Create">Thêm sản phẩm đầu tiên</a>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    var stockStyle = $"width:{Math.Min(100, item.Stock)}%;";
                    <tr>
                        <td>
                            <div class="product-cell">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="product-thumb product-thumb--large" style="object-fit:cover" />
                                }
                                else
                                {
                                    <span class="product-thumb product-thumb--large tone-@item.Tone">@item.Initials</span>
                                }
                                <span><strong>@item.Name</strong><small>@item.Sku</small></span>
                            </div>
                        </td>
                        <td><div class="stacked-text"><strong>@item.Category</strong><small>@item.Brand</small></div></td>
                        <td>@(item.VariantCount > 0 ? $"{item.VariantCount} biến thể" : "Sản phẩm đơn")</td>
                        <td><strong>@item.Price</strong></td>
                        <td>
                            <div class="stock-value">
                                <strong>@item.Stock</strong>
                                <span class="stock-bar"><i style="@stockStyle"></i></span>
                            </div>
                        </td>
                        <td><span class="status-pill @UiStatus.Class(item.Status)">@item.Status</span></td>
                        <td class="table-actions">
                            <a class="icon-btn" asp-action="Edit" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button class="icon-btn" type="submit" title="Bật hoặc tạm ẩn"><i class="bi bi-eye"></i></button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Xóa sản phẩm này? Dữ liệu sẽ được xóa mềm và lịch sử giá vẫn được giữ lại.');">
                                @Html.AntiForgeryToken()
                                <button class="icon-btn" type="submit" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <div class="pagination"><span>Hiển thị @Model.Items.Count trong @Model.TotalCount sản phẩm</span></div>
</section>
