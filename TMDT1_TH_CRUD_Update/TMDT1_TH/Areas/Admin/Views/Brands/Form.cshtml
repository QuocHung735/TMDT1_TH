@model BrandFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Chỉnh sửa thương hiệu" : "Thêm thương hiệu";
    ViewData["Description"] = "Thông tin thương hiệu nhất quán giúp khách hàng dễ nhận diện.";
}
<form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="card panel form-stack">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-grid form-grid--2">
        <label class="form-field"><span asp-for="Name"></span><input asp-for="Name" /><span asp-validation-for="Name" class="text-danger"></span></label>
        <label class="form-field"><span>Slug</span><input asp-for="Slug" placeholder="Để trống để tự tạo" /></label>
    </div>
    <div class="form-grid form-grid--2">
        <label class="form-field"><span asp-for="Country"></span><input asp-for="Country" /></label>
        <label class="form-field"><span>Website</span><input asp-for="WebsiteUrl" /><span asp-validation-for="WebsiteUrl" class="text-danger"></span></label>
    </div>
    <label class="form-field"><span asp-for="LogoUrl"></span><input asp-for="LogoUrl" /></label>
    <label class="form-field"><span asp-for="Description"></span><textarea asp-for="Description" rows="4"></textarea></label>
    <label class="switch-row"><span><strong>Đang hoạt động</strong><small>Cho phép sử dụng thương hiệu khi tạo sản phẩm.</small></span><input asp-for="IsActive" /><i></i></label>
    <div class="modal__footer"><a class="btn btn-light" asp-action="Index">Hủy</a><button class="btn btn-primary" type="submit">Lưu thương hiệu</button></div>
</form>
