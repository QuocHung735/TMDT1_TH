@model IReadOnlyList<TMDT1_TH.Domain.Entities.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
    ViewData["Description"] = "Tổ chức sản phẩm theo cấu trúc dễ tìm kiếm và thuận tiện cho người mua.";
}
@section PageActions {
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm danh mục</a>
}

<section class="card panel">
    <form method="get" class="toolbar">
        <label class="field-search"><i class="bi bi-search"></i><input type="search" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm theo tên hoặc slug..." /></label>
        <div class="toolbar__filters">
            <select class="form-select" name="active">
                <option value="">Tất cả trạng thái</option>
                <option value="true" selected="@(ViewBag.Active is true)">Đang hiển thị</option>
                <option value="false" selected="@(ViewBag.Active is false)">Đã ẩn</option>
            </select>
            <button class="btn btn-light" type="submit"><i class="bi bi-funnel"></i> Lọc</button>
        </div>
    </form>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Danh mục</th><th>Slug</th><th>Danh mục cha</th><th>Sản phẩm</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><div class="category-cell"><span class="category-icon"><i class="bi bi-folder2"></i></span><strong>@item.Name</strong></div></td>
                    <td><code>@item.Slug</code></td>
                    <td>@(item.Parent?.Name ?? "—")</td>
                    <td>@item.Products.Count(x => !x.IsDeleted) sản phẩm</td>
                    <td><span class="status-pill @(item.IsActive ? "is-success" : "is-muted")">@(item.IsActive ? "Đang hiển thị" : "Đã ẩn")</span></td>
                    <td class="table-actions">
                        <a class="icon-btn" asp-action="Edit" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Toggle" asp-route-id="@item.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="icon-btn" title="Ẩn/hiện"><i class="bi bi-eye-slash"></i></button></form>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa mềm danh mục này?')">@Html.AntiForgeryToken()<button class="icon-btn" title="Xóa"><i class="bi bi-trash"></i></button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
