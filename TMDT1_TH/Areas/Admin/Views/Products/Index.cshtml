@model ProductsViewModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    ViewData["Description"] = "Quản lý thông tin, biến thể, tồn kho và trạng thái bán của sản phẩm.";
}
@section PageActions {
    <button class="btn btn-light"><i class="bi bi-upload"></i> Nhập dữ liệu</button>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
}

<section class="segmented-stats">
    <button class="is-active"><strong>48</strong><span>Tất cả</span></button>
    <button><strong>39</strong><span>Đang bán</span></button>
    <button><strong>5</strong><span>Bản nháp</span></button>
    <button><strong>4</strong><span>Hết hàng</span></button>
</section>

<section class="card panel">
    <div class="toolbar toolbar--wrap">
        <label class="field-search"><i class="bi bi-search"></i><input type="search" placeholder="Tìm tên sản phẩm hoặc SKU..." data-table-search="product-table" /></label>
        <div class="toolbar__filters">
            <select class="form-select"><option>Tất cả danh mục</option><option>Điện gia dụng</option><option>Nồi & chảo</option><option>Vệ sinh nhà cửa</option><option>Lưu trữ & sắp xếp</option></select>
            <select class="form-select"><option>Tất cả thương hiệu</option><option>Mây Home</option><option>Bếp Xinh</option><option>PureNest</option><option>CleanJoy</option></select>
            <button class="btn btn-light"><i class="bi bi-funnel"></i> Bộ lọc</button>
        </div>
    </div>
    <div class="bulk-bar" data-bulk-bar><span><strong data-selected-count>0</strong> sản phẩm đã chọn</span><button class="btn btn-light btn-sm">Đổi trạng thái</button><button class="btn btn-light btn-sm">Gán danh mục</button><button class="btn btn-danger-soft btn-sm">Xóa</button></div>
    <div class="table-wrap">
        <table class="data-table" id="product-table">
            <thead><tr><th><input type="checkbox" data-check-all /></th><th>Sản phẩm</th><th>Danh mục / Thương hiệu</th><th>Biến thể</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr data-search-row>
                    <td><input type="checkbox" data-row-check /></td>
                    <td><div class="product-cell"><span class="product-thumb product-thumb--large tone-@item.Tone">@item.Initials</span><span><strong>@item.Name</strong><small>@item.Sku</small></span></div></td>
                    <td><div class="stacked-text"><strong>@item.Category</strong><small>@item.Brand</small></div></td>
                    <td>@item.VariantCount biến thể</td><td><strong>@item.Price</strong></td>
                    <td><div class="stock-value"><strong>@item.Stock</strong><span class="stock-bar"><i style="width:@Math.Min(100, item.Stock)%"></i></span></div></td>
                    <td><span class="status-pill @UiStatus.Class(item.Status)">@item.Status</span></td>
                    <td class="table-actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a><button class="icon-btn"><i class="bi bi-three-dots"></i></button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="pagination"><span>Hiển thị 1–5 trong 48 sản phẩm</span><div><button><i class="bi bi-chevron-left"></i></button><button class="is-current">1</button><button>2</button><button>3</button><button><i class="bi bi-chevron-right"></i></button></div></div>
</section>
