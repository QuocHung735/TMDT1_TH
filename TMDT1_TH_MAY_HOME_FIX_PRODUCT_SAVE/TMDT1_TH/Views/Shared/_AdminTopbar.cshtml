<header class="admin-topbar">
    <button class="icon-btn topbar-menu" type="button" data-sidebar-toggle aria-label="Mở menu">
        <i class="bi bi-list"></i>
    </button>

    <label class="global-search">
        <i class="bi bi-search"></i>
        <input type="search" placeholder="Tìm sản phẩm, SKU, danh mục..." aria-label="Tìm kiếm toàn hệ thống" />
        <kbd>Ctrl K</kbd>
    </label>

    <div class="topbar-actions">
        <button class="icon-btn has-indicator" type="button" title="Thông báo">
            <i class="bi bi-bell"></i><span></span>
        </button>
        <button class="profile-button" type="button" data-dropdown-toggle>
            <span class="avatar">QH</span>
            <span class="profile-button__text"><strong>Quốc Hưng</strong><small>Quản trị viên</small></span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="profile-menu" data-dropdown-menu>
            <a href="#"><i class="bi bi-person"></i> Hồ sơ cá nhân</a>
            <a href="#"><i class="bi bi-sliders"></i> Tùy chọn</a>
            <hr />
            <a href="#"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
        </div>
    </div>
</header>
