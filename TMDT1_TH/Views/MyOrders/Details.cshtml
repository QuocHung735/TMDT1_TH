@using System.Globalization
@model TMDT1_TH.ViewModels.Storefront.CustomerOrderDetailsViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = $"Đơn hàng {Model.OrderNumber}";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var steps = new[]
    {
        "Đã đặt hàng",
        "Đã xác nhận",
        "Đang chuẩn bị",
        "Đang giao",
        "Hoàn thành"
    };
}

<section class="account-page account-page--orders">
    <div class="store-container">
        <div class="order-page-heading">
            <div>
                <a class="order-back-link"
                   asp-action="Index">
                    ← Tất cả đơn hàng
                </a>
                <h1>@Model.OrderNumber</h1>
                <p>
                    Đặt lúc
                    @VietnamDateTime.Format(Model.CreatedAt, "dd/MM/yyyy HH:mm")
                </p>
            </div>
            <span class="customer-order-status @Model.StatusClass">
                @Model.StatusName
            </span>
        </div>

        @if (TempData["OrderSuccess"] is string successMessage)
        {
            <div class="customer-order-alert is-success"
                 role="status">
                <strong>Thành công</strong>
                <span>@successMessage</span>
            </div>
        }

        @if (TempData["OrderError"] is string errorMessage)
        {
            <div class="customer-order-alert is-error"
                 role="alert">
                <strong>Không thể thực hiện</strong>
                <span>@errorMessage</span>
            </div>
        }

        @if (Model.IsCancelled)
        {
            <div class="order-cancelled-box">
                <strong>Đơn hàng đã bị hủy</strong>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.CancellationReason)
                        ? "Không có lý do hủy được ghi nhận."
                        : Model.CancellationReason)
                </p>
            </div>
        }
        else
        {
            <section class="order-tracking-card">
                <h2>Tiến trình đơn hàng</h2>
                <div class="order-tracking">
                    @for (var index = 0; index < steps.Length; index++)
                    {
                        var step = index + 1;
                        var active = step <= Model.ProgressStep;

                        <div class="order-track-step @(active ? "is-active" : "")">
                            <span>@(active ? "✓" : step)</span>
                            <strong>@steps[index]</strong>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="customer-shipment-card">
            <div class="customer-shipment-card__heading">
                <div>
                    <span class="eyebrow">GIAO NHẬN</span>
                    <h2>Theo dõi vận chuyển</h2>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.TrackingNumber))
                {
                    <span class="shipment-code">
                        @Model.TrackingNumber
                    </span>
                }
            </div>

            <div class="customer-shipment-grid">
                <div>
                    <small>Đơn vị giao nhận</small>
                    <strong>
                        @(Model.ShippingCarrierName
                            ?? "Đang cập nhật")
                    </strong>
                </div>
                <div>
                    <small>Dịch vụ</small>
                    <strong>
                        @(Model.ShippingServiceName
                            ?? "Đang cập nhật")
                    </strong>
                </div>
                <div>
                    <small>Dự kiến giao</small>
                    <strong>
                        @(Model.EstimatedDeliveryAt.HasValue
                            ? VietnamDateTime.Format(Model.EstimatedDeliveryAt.Value, "dd/MM/yyyy")
                            : "Đang cập nhật")
                    </strong>
                </div>
                <div>
                    <small>Trạng thái giao hàng</small>
                    <strong>
                        @(Model.DeliveredAt.HasValue
                            ? "Đã giao thành công"
                            : Model.ShippedAt.HasValue
                                ? "Đang vận chuyển"
                                : "Chờ bàn giao")
                    </strong>
                </div>
            </div>

            <div class="customer-shipment-timeline">
                <div class="is-done">
                    <span>✓</span>
                    <div>
                        <strong>Đã đặt hàng</strong>
                        <small>
                            @VietnamDateTime.Format(Model.CreatedAt, "dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                </div>

                <div class="@(Model.ShippedAt.HasValue ? "is-done" : "")">
                    <span>
                        @(Model.ShippedAt.HasValue ? "✓" : "2")
                    </span>
                    <div>
                        <strong>Bàn giao đơn vị vận chuyển</strong>
                        <small>
                            @(Model.ShippedAt.HasValue
                                ? VietnamDateTime.Format(Model.ShippedAt.Value, "dd/MM/yyyy HH:mm")
                                : "Chưa bàn giao")
                        </small>
                    </div>
                </div>

                <div class="@(Model.DeliveredAt.HasValue ? "is-done" : "")">
                    <span>
                        @(Model.DeliveredAt.HasValue ? "✓" : "3")
                    </span>
                    <div>
                        <strong>Giao hàng thành công</strong>
                        <small>
                            @(Model.DeliveredAt.HasValue
                                ? VietnamDateTime.Format(Model.DeliveredAt.Value, "dd/MM/yyyy HH:mm")
                                : "Chưa hoàn thành")
                        </small>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ShippingNote))
            {
                <div class="customer-shipment-note">
                    <strong>Ghi chú giao nhận</strong>
                    <p>@Model.ShippingNote</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.TrackingUrl))
            {
                <a class="store-button store-button--primary"
                   href="@Model.TrackingUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    Tra cứu trên website đơn vị vận chuyển
                </a>
            }
            else if (!string.IsNullOrWhiteSpace(Model.TrackingNumber))
            {
                <p class="customer-shipment-help">
                    Mã vận đơn đã được cập nhật.
                    Đơn vị vận chuyển chưa cấu hình liên kết tra cứu.
                </p>
            }
        </section>

        <div class="customer-order-layout">
            <div class="customer-order-main">
                <section class="checkout-card">
                    <h2>Sản phẩm</h2>
                    <div class="confirmation-items">
                        @foreach (var item in Model.Items)
                        {
                            <article class="checkout-item">
                                <div class="checkout-item__image">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <span>Mây Home</span>
                                    }
                                </div>

                                <div>
                                    <b>@item.ProductName</b>
                                    @if (!string.IsNullOrWhiteSpace(item.VariantName))
                                    {
                                        <small>@item.VariantName</small>
                                    }
                                    <small>
                                        @item.Sku ·
                                        SL @item.Quantity @item.Unit
                                    </small>
                                </div>

                                <strong>
                                    @item.LineTotal.ToString("N0", culture)
                                    @Model.CurrencyCode
                                </strong>
                            </article>
                        }
                    </div>
                </section>

                <section class="checkout-card">
                    <h2>Thông tin nhận hàng</h2>
                    <dl class="order-recipient">
                        <div>
                            <dt>Người nhận</dt>
                            <dd>@Model.CustomerName</dd>
                        </div>
                        <div>
                            <dt>Điện thoại</dt>
                            <dd>@Model.CustomerPhone</dd>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                        {
                            <div>
                                <dt>Email</dt>
                                <dd>@Model.CustomerEmail</dd>
                            </div>
                        }
                        <div>
                            <dt>Địa chỉ</dt>
                            <dd>@Model.ShippingAddress</dd>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
                        {
                            <div>
                                <dt>Ghi chú</dt>
                                <dd>@Model.CustomerNote</dd>
                            </div>
                        }
                    </dl>
                </section>
            </div>

            <aside class="checkout-summary">
                <h2>Thanh toán</h2>

                <dl class="order-recipient">
                    <div>
                        <dt>Phương thức</dt>
                        <dd>@Model.PaymentMethodName</dd>
                    </div>
                    <div>
                        <dt>Trạng thái</dt>
                        <dd>@Model.PaymentStatusName</dd>
                    </div>
                </dl>

                <dl class="checkout-totals">
                    <div>
                        <dt>Tạm tính</dt>
                        <dd>
                            @Model.Subtotal.ToString("N0", culture)
                            @Model.CurrencyCode
                        </dd>
                    </div>
                    <div>
                        <dt>Vận chuyển</dt>
                        <dd>
                            @(Model.ShippingFee == 0
                                ? "Miễn phí"
                                : $"{Model.ShippingFee:N0} {Model.CurrencyCode}")
                        </dd>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div>
                            <dt>Giảm giá</dt>
                            <dd>
                                -@Model.DiscountAmount.ToString("N0", culture)
                                @Model.CurrencyCode
                            </dd>
                        </div>
                    }
                </dl>

                <div class="checkout-total">
                    <span>Tổng thanh toán</span>
                    <strong>
                        @Model.TotalAmount.ToString("N0", culture)
                        @Model.CurrencyCode
                    </strong>
                </div>

                @if (Model.CanCustomerCancel)
                {
                    <div class="customer-cancel-panel">
                        <button class="store-button customer-cancel-button"
                                type="button"
                                data-cancel-dialog-open>
                            Hủy đơn hàng
                        </button>
                        <small>
                            Chỉ có thể hủy khi đơn đang chờ xác nhận.
                            Thao tác này không thể hoàn tác.
                        </small>
                    </div>
                }
            </aside>
        </div>
    </div>
</section>

@if (Model.CanCustomerCancel)
{
    <dialog class="customer-cancel-dialog"
            data-cancel-dialog>
        <form asp-action="Cancel"
              asp-route-orderNumber="@Model.OrderNumber"
              method="post">
            <div class="customer-cancel-dialog__heading">
                <div>
                    <span class="eyebrow">XÁC NHẬN HỦY</span>
                    <h2>Hủy đơn @Model.OrderNumber?</h2>
                </div>
                <button type="button"
                        aria-label="Đóng"
                        data-cancel-dialog-close>
                    ×
                </button>
            </div>

            <p>
                Sản phẩm sẽ được hoàn lại kho và lượt khuyến mãi
                của đơn sẽ được trả lại.
            </p>

            <label for="cancellationReason">
                Lý do hủy đơn
            </label>
            <textarea id="cancellationReason"
                      name="cancellationReason"
                      rows="4"
                      minlength="5"
                      maxlength="450"
                      required
                      placeholder="Ví dụ: Tôi đổi ý và không còn nhu cầu mua sản phẩm này."></textarea>
            <small>
                Nhập từ 5 đến 450 ký tự.
            </small>

            <div class="customer-cancel-dialog__actions">
                <button class="store-button"
                        type="button"
                        data-cancel-dialog-close>
                    Giữ lại đơn
                </button>
                <button class="store-button customer-cancel-confirm"
                        type="submit">
                    Xác nhận hủy
                </button>
            </div>
        </form>
    </dialog>
}

<style>
    .customer-order-alert {
        display: grid;
        gap: 4px;
        margin: 18px 0;
        padding: 14px 16px;
        border: 1px solid;
        border-radius: 14px;
    }

    .customer-order-alert.is-success {
        border-color: #b8dfc7;
        background: #f1fbf4;
        color: #21683c;
    }

    .customer-order-alert.is-error {
        border-color: #f0b8b8;
        background: #fff4f4;
        color: #a42b2b;
    }

    .customer-cancel-panel {
        display: grid;
        gap: 10px;
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #ece8f2;
    }

    .customer-cancel-panel small {
        color: #77718c;
        line-height: 1.5;
    }

    .customer-cancel-button,
    .customer-cancel-confirm {
        border-color: #c83d3d;
        background: #c83d3d;
        color: #fff;
    }

    .customer-cancel-button:hover,
    .customer-cancel-confirm:hover {
        border-color: #aa2e2e;
        background: #aa2e2e;
    }

    .customer-cancel-dialog {
        width: min(520px, calc(100vw - 32px));
        padding: 0;
        border: 0;
        border-radius: 20px;
        box-shadow: 0 24px 70px rgba(35, 24, 53, .28);
    }

    .customer-cancel-dialog::backdrop {
        background: rgba(27, 18, 39, .58);
        backdrop-filter: blur(3px);
    }

    .customer-cancel-dialog form {
        display: grid;
        gap: 16px;
        padding: 24px;
    }

    .customer-cancel-dialog__heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
    }

    .customer-cancel-dialog__heading h2 {
        margin: 4px 0 0;
    }

    .customer-cancel-dialog__heading > button {
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: #f1eef5;
        font-size: 24px;
        cursor: pointer;
    }

    .customer-cancel-dialog label {
        font-weight: 700;
    }

    .customer-cancel-dialog textarea {
        width: 100%;
        resize: vertical;
        min-height: 110px;
        padding: 12px 14px;
        border: 1px solid #d9d3e2;
        border-radius: 12px;
        font: inherit;
    }

    .customer-cancel-dialog textarea:focus {
        outline: 2px solid rgba(143, 96, 171, .2);
        border-color: #8f60ab;
    }

    .customer-cancel-dialog > form > small {
        margin-top: -10px;
        color: #77718c;
    }

    .customer-cancel-dialog__actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 4px;
    }

    @@media (max-width: 560px) {
        .customer-cancel-dialog__actions {
            display: grid;
        }
    }
</style>

<script>
    (() => {
        const dialog =
            document.querySelector("[data-cancel-dialog]");

        if (!dialog) {
            return;
        }

        document
            .querySelector("[data-cancel-dialog-open]")
            ?.addEventListener("click", () => {
                dialog.showModal();
            });

        dialog
            .querySelectorAll("[data-cancel-dialog-close]")
            .forEach(button => {
                button.addEventListener("click", () => {
                    dialog.close();
                });
            });

        dialog.addEventListener("click", event => {
            if (event.target === dialog) {
                dialog.close();
            }
        });
    })();
</script>

