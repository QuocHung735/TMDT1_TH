@model TMDT1_TH.Areas.Admin.ViewModels.PromotionRedemptionHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử dùng khuyến mãi";
    ViewData["Description"] =
        "Theo dõi mã đã áp dụng cho đơn hàng và các lượt đã hoàn khi đơn bị hủy.";

    var culture =
        System.Globalization.CultureInfo
            .GetCultureInfo("vi-VN");
}

@section PageActions {
    <a class="btn btn-light"
       asp-controller="Promotions"
       asp-action="Index">
        <i class="bi bi-arrow-left"></i>
        Quay lại khuyến mãi
    </a>
}

<section class="pricing-overview">
    <article class="pricing-overview__card">
        <span class="tone-purple">
            <i class="bi bi-receipt"></i>
        </span>
        <div>
            <small>Tổng lịch sử</small>
            <strong>@Model.TotalCount</strong>
            <em>lượt đã ghi nhận</em>
        </div>
    </article>

    <article class="pricing-overview__card">
        <span class="tone-mint">
            <i class="bi bi-check2-circle"></i>
        </span>
        <div>
            <small>Đang tính lượt</small>
            <strong>@Model.ActiveCount</strong>
            <em>đơn chưa hủy</em>
        </div>
    </article>

    <article class="pricing-overview__card">
        <span class="tone-amber">
            <i class="bi bi-arrow-counterclockwise"></i>
        </span>
        <div>
            <small>Đã hoàn lượt</small>
            <strong>@Model.ReleasedCount</strong>
            <em>do đơn bị hủy</em>
        </div>
    </article>

    <article class="pricing-overview__card">
        <span class="tone-blue">
            <i class="bi bi-cash-stack"></i>
        </span>
        <div>
            <small>Tổng tiền đã giảm</small>
            <strong>
                @Model.TotalDiscountAmount.ToString("N0", culture)đ
            </strong>
            <em>
                hoàn @Model.ReleasedDiscountAmount.ToString("N0", culture)đ
            </em>
        </div>
    </article>
</section>

<section class="card panel">
    <form method="get"
          class="toolbar toolbar--wrap">
        <label class="field-search">
            <i class="bi bi-search"></i>
            <input type="search"
                   name="q"
                   value="@Model.Query"
                   placeholder="Mã khuyến mãi, mã đơn, khách hàng..." />
        </label>

        <div class="toolbar__filters">
            <select name="state"
                    class="form-select">
                <option value=""
                        selected="@(string.IsNullOrWhiteSpace(Model.State))">
                    Tất cả trạng thái
                </option>
                <option value="active"
                        selected="@(Model.State == "active")">
                    Đang tính lượt
                </option>
                <option value="released"
                        selected="@(Model.State == "released")">
                    Đã hoàn lượt
                </option>
            </select>

            <button class="btn btn-light"
                    type="submit">
                <i class="bi bi-funnel"></i>
                Lọc
            </button>

            <a class="btn btn-light"
               asp-action="Redemptions">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Khuyến mãi</th>
                    <th>Đơn hàng</th>
                    <th>Khách hàng</th>
                    <th>Tiền giảm</th>
                    <th>Thời điểm dùng</th>
                    <th>Trạng thái lượt</th>
                    <th>Thời điểm hoàn</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <i class="bi bi-receipt"></i>
                            <strong>Chưa có lịch sử phù hợp</strong>
                            <p>
                                Lịch sử sẽ xuất hiện khi khách đặt đơn
                                có sử dụng mã khuyến mãi.
                            </p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="stacked-text">
                                <strong>@item.PromotionName</strong>
                                <small>@item.PromotionCode</small>
                            </div>
                        </td>

                        <td>
                            <a asp-area="Admin"
                               asp-controller="Orders"
                               asp-action="Details"
                               asp-route-id="@item.OrderId">
                                @item.OrderNumber
                            </a>
                        </td>

                        <td>
                            <div class="stacked-text">
                                <strong>@item.CustomerName</strong>
                                <small>@(item.CustomerEmail ?? "—")</small>
                            </div>
                        </td>

                        <td>
                            <strong class="sale-price">
                                @item.DiscountAmount.ToString("N0", culture)
                                @item.CurrencyCode
                            </strong>
                        </td>

                        <td>
                            @VietnamDateTime.Format(item.RedeemedAt)
                        </td>

                        <td>
                            @if (item.IsReleased)
                            {
                                <span class="status-pill status-cancelled">
                                    Đã hoàn lượt
                                </span>

                                @if (!string.IsNullOrWhiteSpace(
                                        item.ReleaseReason))
                                {
                                    <small class="redemption-reason">
                                        @item.ReleaseReason
                                    </small>
                                }
                            }
                            else
                            {
                                <span class="status-pill status-active">
                                    Đang tính lượt
                                </span>
                            }
                        </td>

                        <td>
                            @VietnamDateTime.Format(item.ReleasedAt)
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

<style>
    .redemption-reason {
        display: block;
        max-width: 280px;
        margin-top: 6px;
        color: #77718c;
        line-height: 1.45;
    }
</style>
