@model TMDT1_TH.ViewModels.Storefront.CreateProductReviewViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Viết đánh giá";
}

<section class="account-page">
    <div class="store-container review-create-layout">
        <aside class="review-product-card">
            <div class="review-product-card__image">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.ProductName" />
                }
                else
                {
                    <span>Mây Home</span>
                }
            </div>

            <small>Đơn hàng @Model.OrderNumber</small>
            <h1>@Model.ProductName</h1>

            @if (!string.IsNullOrWhiteSpace(Model.VariantName))
            {
                <p>@Model.VariantName</p>
            }

            <div class="verified-purchase-badge">
                ✓ Đã mua hàng tại Mây Home
            </div>
        </aside>

        <form asp-action="Create"
              method="post"
              class="account-card review-create-form">
            <input asp-for="OrderItemId" type="hidden" />

            <span class="eyebrow">ĐÁNH GIÁ SẢN PHẨM</span>
            <h2>Chia sẻ trải nghiệm của bạn</h2>
            <p class="account-card__lead">
                Đánh giá sẽ được Admin kiểm tra trước khi hiển thị công khai.
            </p>

            <div asp-validation-summary="ModelOnly"
                 class="account-validation"></div>

            <fieldset class="review-rating-field">
                <legend>@Html.DisplayNameFor(x => x.Rating)</legend>
                <div class="review-rating-input">
                    @for (var rating = 5; rating >= 1; rating--)
                    {
                        <input type="radio"
                               id="rating-@rating"
                               asp-for="Rating"
                               value="@rating" />
                        <label for="rating-@rating"
                               title="@rating sao">★</label>
                    }
                </div>
                <small asp-validation-for="Rating"></small>
            </fieldset>

            <label class="account-field">
                <span>@Html.DisplayNameFor(x => x.Title)</span>
                <input asp-for="Title"
                       maxlength="150"
                       placeholder="Ví dụ: Sản phẩm dùng rất tốt" />
                <small asp-validation-for="Title"></small>
            </label>

            <label class="account-field">
                <span>@Html.DisplayNameFor(x => x.Comment)</span>
                <textarea asp-for="Comment"
                          rows="7"
                          maxlength="2000"
                          placeholder="Hãy mô tả chất lượng, đóng gói và trải nghiệm sử dụng..."></textarea>
                <small asp-validation-for="Comment"></small>
            </label>

            <div class="review-form-actions">
                <a class="store-button store-button--ghost"
                   asp-action="Index">Quay lại</a>
                <button class="store-button store-button--primary"
                        type="submit">
                    Gửi đánh giá
                </button>
            </div>
        </form>
    </div>
</section>
