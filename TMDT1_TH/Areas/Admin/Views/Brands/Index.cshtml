@model BrandsViewModel
@{
    ViewData["Title"] = "Quản lý thương hiệu";
    ViewData["Description"] = "Chuẩn hóa thông tin thương hiệu để tăng độ tin cậy khi khách lựa chọn sản phẩm.";
    var formAction = Model.Form.Id.HasValue ? "Edit" : "Create";
    var modalTitle = Model.Form.Id.HasValue ? "Chỉnh sửa thương hiệu" : "Thêm thương hiệu";
}

@section PageActions {
    <button class="btn btn-primary"
            type="button"
            data-modal-target="brand-modal">
        <i class="bi bi-plus-lg"></i>
        Thêm thương hiệu
    </button>
}

<section class="summary-strip">
    <div>
        <span class="summary-strip__icon tone-purple">
            <i class="bi bi-patch-check"></i>
        </span>
        <p>
            <strong>@Model.TotalCount</strong>
            <small>Tổng thương hiệu</small>
        </p>
    </div>
    <div>
        <span class="summary-strip__icon tone-mint">
            <i class="bi bi-eye"></i>
        </span>
        <p>
            <strong>@Model.ActiveCount</strong>
            <small>Đang hoạt động</small>
        </p>
    </div>
    <div>
        <span class="summary-strip__icon tone-amber">
            <i class="bi bi-box-seam"></i>
        </span>
        <p>
            <strong>@Model.ProductCount</strong>
            <small>Sản phẩm trong hệ thống</small>
        </p>
    </div>
</section>

<section class="card panel catalog-filter-panel">
    <form method="get" class="toolbar">
        <label class="field-search">
            <i class="bi bi-search"></i>
            <input type="search"
                   name="q"
                   value="@Model.Search"
                   placeholder="Tìm tên, slug hoặc quốc gia..." />
        </label>

        <div class="toolbar__filters">
            <select class="form-select" name="active">
                <option value=""
                        selected="@(!Model.Active.HasValue)">
                    Tất cả trạng thái
                </option>
                <option value="true"
                        selected="@(Model.Active == true)">
                    Đang hoạt động
                </option>
                <option value="false"
                        selected="@(Model.Active == false)">
                    Tạm ẩn
                </option>
            </select>

            <button class="btn btn-light" type="submit">
                <i class="bi bi-funnel"></i>
                Lọc
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.Search) ||
                 Model.Active.HasValue)
            {
                <a class="btn btn-light"
                   asp-action="Index">
                    <i class="bi bi-x-lg"></i>
                    Xóa lọc
                </a>
            }
        </div>
    </form>
</section>

@if (Model.Items.Count == 0)
{
    <section class="card empty-state">
        <span class="empty-state__icon">
            <i class="bi bi-patch-check"></i>
        </span>
        <h2>Chưa có thương hiệu phù hợp</h2>
        <p>
            Hãy tạo thương hiệu đầu tiên hoặc thay đổi điều kiện tìm kiếm.
        </p>
        <button class="btn btn-primary"
                type="button"
                data-modal-target="brand-modal">
            <i class="bi bi-plus-lg"></i>
            Thêm thương hiệu
        </button>
    </section>
}
else
{
    <section class="brand-grid">
        @foreach (var item in Model.Items)
        {
            <article class="brand-card card">
                <div class="brand-card__header">
                    @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                    {
                        <span class="brand-logo brand-logo--image">
                            <img src="@item.LogoUrl"
                                 alt="Logo @item.Name" />
                        </span>
                    }
                    else
                    {
                        <span class="brand-logo tone-@item.Tone">
                            @item.Initials
                        </span>
                    }

                    <div class="brand-card__actions">
                        <a class="icon-btn"
                           title="Chỉnh sửa"
                           asp-action="Index"
                           asp-route-editId="@item.Id">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <form asp-action="Toggle"
                              method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />
                            <button class="icon-btn"
                                    type="submit"
                                    title="@(item.IsActive ? "Tạm ẩn" : "Kích hoạt")">
                                <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </form>

                        <form asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Bạn chắc chắn muốn xóa thương hiệu này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />
                            <button class="icon-btn icon-btn--danger"
                                    type="submit"
                                    title="Xóa">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <div class="brand-card__body">
                    <h2>@item.Name</h2>
                    <p>
                        <i class="bi bi-geo-alt"></i>
                        @item.Country
                    </p>
                    <code>@item.Slug</code>

                    @if (!string.IsNullOrWhiteSpace(item.WebsiteUrl))
                    {
                        <a class="brand-website"
                           href="@item.WebsiteUrl"
                           target="_blank"
                           rel="noopener">
                            <i class="bi bi-globe2"></i>
                            Website
                        </a>
                    }
                </div>

                <div class="brand-card__footer">
                    <span>
                        <strong>@item.ProductCount</strong>
                        sản phẩm
                    </span>
                    <span class="status-pill @UiStatus.Class(item.Status)">
                        @item.Status
                    </span>
                </div>
            </article>
        }

        <button class="brand-card brand-card--add"
                type="button"
                data-modal-target="brand-modal">
            <span>
                <i class="bi bi-plus-lg"></i>
            </span>
            <strong>Thêm thương hiệu</strong>
            <small>Tạo hồ sơ thương hiệu mới</small>
        </button>
    </section>
}

<div class="modal @(Model.OpenFormModal ? "is-open" : string.Empty)"
     id="brand-modal"
     aria-hidden="@(!Model.OpenFormModal).ToString().ToLowerInvariant()">
    <div class="modal__backdrop"
         data-modal-close></div>

    <div class="modal__dialog">
        <form asp-action="@formAction"
              method="post"
              enctype="multipart/form-data"
              data-brand-form>
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="Id"
                   value="@Model.Form.Id" />

            <div class="modal__header">
                <div>
                    <h2>@modalTitle</h2>
                    <p>
                        Thông tin súc tích giúp khách hàng nhận diện nhanh.
                    </p>
                </div>

                <a class="icon-btn"
                   asp-action="Index"
                   aria-label="Đóng">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

            <div class="modal__body form-stack">
                <div asp-validation-summary="All"
                     class="validation-summary"></div>

                <label class="form-field">
                    <span>
                        Tên thương hiệu <em>*</em>
                    </span>
                    <input name="Name"
                           value="@Model.Form.Name"
                           placeholder="Ví dụ: Panasonic" />
                    @Html.ValidationMessage(
                        "Name",
                        null,
                        new { @class = "field-error" })
                </label>

                <label class="form-field">
                    <span>Slug</span>
                    <input name="Slug"
                           value="@Model.Form.Slug"
                           placeholder="Để trống để tự tạo từ tên" />
                    <small>
                        Slug trống sẽ được hệ thống tự tạo và chống trùng.
                    </small>
                    @Html.ValidationMessage(
                        "Slug",
                        null,
                        new { @class = "field-error" })
                </label>

                <div class="form-grid form-grid--2">
                    <label class="form-field">
                        <span>Quốc gia</span>
                        <input name="Country"
                               value="@Model.Form.Country"
                               placeholder="Nhật Bản" />
                        @Html.ValidationMessage(
                            "Country",
                            null,
                            new { @class = "field-error" })
                    </label>

                    <label class="form-field">
                        <span>Website</span>
                        <input name="WebsiteUrl"
                               value="@Model.Form.WebsiteUrl"
                               type="url"
                               placeholder="https://" />
                        @Html.ValidationMessage(
                            "WebsiteUrl",
                            null,
                            new { @class = "field-error" })
                    </label>
                </div>

                <section class="brand-logo-editor">
                    <div class="brand-logo-editor__heading">
                        <div>
                            <strong>Logo thương hiệu</strong>
                            <small>
                                JPG, PNG hoặc WEBP · tối đa 2 MB
                            </small>
                        </div>
                    </div>

                    <div class="brand-logo-editor__content">
                        <div class="brand-logo-preview"
                             data-brand-logo-preview>
                            @if (!string.IsNullOrWhiteSpace(Model.Form.LogoUrl))
                            {
                                <img src="@Model.Form.LogoUrl"
                                     alt="Logo hiện tại" />
                            }
                            else
                            {
                                <span>
                                    <i class="bi bi-image"></i>
                                </span>
                            }
                        </div>

                        <div class="brand-logo-editor__controls">
                            <label class="brand-logo-upload">
                                <input type="file"
                                       name="LogoFile"
                                       accept="image/jpeg,image/png,image/webp"
                                       data-brand-logo-input />
                                <span>
                                    <i class="bi bi-cloud-arrow-up"></i>
                                    Chọn ảnh từ máy
                                </span>
                            </label>

                            <small>
                                Khuyến nghị logo vuông, nền trong suốt hoặc nền trắng,
                                kích thước từ 300 × 300 px.
                            </small>

                            @Html.ValidationMessage(
                                "LogoFile",
                                null,
                                new { @class = "field-error" })

                            @if (!string.IsNullOrWhiteSpace(Model.Form.LogoUrl))
                            {
                                <label class="brand-logo-remove">
                                    <input type="checkbox"
                                           name="RemoveLogo"
                                           value="true" />
                                    Xóa logo hiện tại
                                </label>
                            }
                        </div>
                    </div>
                </section>

                <label class="form-field">
                    <span>Mô tả</span>
                    <textarea name="Description"
                              rows="3"
                              placeholder="Câu chuyện hoặc điểm nổi bật của thương hiệu...">@Model.Form.Description</textarea>
                    @Html.ValidationMessage(
                        "Description",
                        null,
                        new { @class = "field-error" })
                </label>

                <label class="switch-row">
                    <span>
                        <strong>Thương hiệu đang hoạt động</strong>
                        <small>
                            Cho phép chọn thương hiệu khi tạo sản phẩm.
                        </small>
                    </span>
                    <input name="IsActive"
                           type="checkbox"
                           value="true"
                           checked="@Model.Form.IsActive" />
                    <i></i>
                </label>
            </div>

            <div class="modal__footer">
                <a class="btn btn-light"
                   asp-action="Index">
                    Hủy
                </a>
                <button class="btn btn-primary"
                        type="submit">
                    @(Model.Form.Id.HasValue
                        ? "Lưu thay đổi"
                        : "Lưu thương hiệu")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const input =
                document.querySelector(
                    "[data-brand-logo-input]");

            const preview =
                document.querySelector(
                    "[data-brand-logo-preview]");

            if (!input || !preview) return;

            input.addEventListener(
                "change",
                () => {
                    const file =
                        input.files?.[0];

                    if (!file) return;

                    const allowed = [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ];

                    if (!allowed.includes(file.type)) {
                        input.value = "";
                        alert(
                            "Logo chỉ nhận JPG, PNG hoặc WEBP.");
                        return;
                    }

                    if (file.size > 2 * 1024 * 1024) {
                        input.value = "";
                        alert(
                            "Logo vượt quá dung lượng tối đa 2 MB.");
                        return;
                    }

                    const url =
                        URL.createObjectURL(file);

                    preview.innerHTML = "";

                    const image =
                        document.createElement("img");

                    image.src = url;
                    image.alt = "Logo mới";

                    image.addEventListener(
                        "load",
                        () => URL.revokeObjectURL(url),
                        { once: true });

                    preview.appendChild(image);
                });
        })();
    </script>
}
