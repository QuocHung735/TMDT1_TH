@model TMDT1_TH.ViewModels.Account.ProfileViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Hồ sơ khách hàng";
}

<section class="customer-profile-page">
    <div class="store-container">
        <header class="customer-profile-hero">
            <div class="customer-profile-avatar"
                 aria-label="Ảnh đại diện">
                @Model.Initials
            </div>

            <div class="customer-profile-identity">
                <span class="eyebrow">HỒ SƠ KHÁCH HÀNG</span>
                <h1>@Model.FullName</h1>
                <p>@Model.Email</p>

                <div class="customer-profile-meta">
                    <span>@Model.RoleName</span>
                    <span>
                        Thành viên từ
                        @VietnamDateTime.Format(Model.CreatedAt, "dd/MM/yyyy")
                    </span>
                    <span class="@(Model.HasDefaultAddress ? "is-complete" : "is-incomplete")">
                        @(Model.HasDefaultAddress
                            ? "Đã có địa chỉ mặc định"
                            : "Chưa có địa chỉ mặc định")
                    </span>
                </div>
            </div>

            <div class="customer-profile-hero__actions">
                <a class="store-button store-button--ghost"
                   asp-controller="MyOrders"
                   asp-action="Index">
                    Đơn hàng của tôi
                </a>
                <a class="store-button store-button--ghost"
                   asp-controller="MyReviews"
                   asp-action="Index">
                    Đánh giá của tôi
                </a>
            </div>
        </header>

        @if (TempData["AccountMessage"] is string message)
        {
            <div class="account-success customer-profile-message">
                @message
            </div>
        }

        <section class="customer-profile-stats"
                 aria-label="Thống kê tài khoản">
            <a asp-controller="MyOrders"
               asp-action="Index">
                <strong>@Model.TotalOrders</strong>
                <span>Tổng đơn hàng</span>
            </a>
            <a asp-controller="MyOrders"
               asp-action="Index">
                <strong>@Model.ActiveOrders</strong>
                <span>Đơn đang xử lý</span>
            </a>
            <a asp-controller="MyOrders"
               asp-action="Index">
                <strong>@Model.CompletedOrders</strong>
                <span>Đơn hoàn thành</span>
            </a>
            <a asp-controller="MyReviews"
               asp-action="Index">
                <strong>@Model.TotalReviews</strong>
                <span>Đánh giá đã gửi</span>
            </a>
        </section>

        <div class="customer-profile-layout">
            <aside class="customer-profile-menu">
                <h2>Tài khoản của tôi</h2>

                <a class="is-active"
                   asp-controller="Account"
                   asp-action="Profile">
                    <span>Thông tin hồ sơ</span>
                    <small>Thông tin cá nhân và địa chỉ</small>
                </a>

                <a asp-controller="MyOrders"
                   asp-action="Index">
                    <span>Đơn hàng của tôi</span>
                    <small>Theo dõi trạng thái đơn</small>
                </a>

                <a asp-controller="MyReviews"
                   asp-action="Index">
                    <span>Đánh giá của tôi</span>
                    <small>Sản phẩm đã mua</small>
                </a>

                <a asp-controller="Account"
                   asp-action="ChangePassword">
                    <span>Đổi mật khẩu</span>
                    <small>Bảo mật tài khoản</small>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <span>Trang quản trị</span>
                        <small>Quản lý Mây Home</small>
                    </a>
                }
            </aside>

            <form asp-action="Profile"
                  method="post"
                  class="customer-profile-form"
                   data-vn-address-form
                   data-vn-address-required="false">
                <div asp-validation-summary="ModelOnly"
                     class="account-validation"></div>

                <section class="customer-profile-card">
                    <div class="customer-profile-card__heading">
                        <div>
                            <span class="eyebrow">THÔNG TIN CÁ NHÂN</span>
                            <h2>Thông tin liên hệ</h2>
                        </div>
                        <p>
                            Email được dùng để đăng nhập nên không thể
                            thay đổi tại trang này.
                        </p>
                    </div>

                    <div class="customer-profile-fields">
                        <label class="account-field customer-profile-field--wide">
                            <span>@Html.DisplayNameFor(x => x.FullName)</span>
                            <input asp-for="FullName"
                                   autocomplete="name" />
                            <small asp-validation-for="FullName"></small>
                        </label>

                        <label class="account-field">
                            <span>@Html.DisplayNameFor(x => x.Email)</span>
                            <input asp-for="Email"
                                   readonly />
                        </label>

                        <label class="account-field">
                            <span>@Html.DisplayNameFor(x => x.PhoneNumber)</span>
                            <input asp-for="PhoneNumber"
                                   autocomplete="tel"
                                   inputmode="tel" />
                            <small asp-validation-for="PhoneNumber"></small>
                        </label>

                        <label class="account-field">
                            <span>@Html.DisplayNameFor(x => x.DateOfBirth)</span>
                            <input asp-for="DateOfBirth"
                                   type="date" />
                            <small asp-validation-for="DateOfBirth"></small>
                        </label>

                        <label class="account-field">
                            <span>@Html.DisplayNameFor(x => x.Gender)</span>
                            <select asp-for="Gender">
                                <option value="">Chưa chọn</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <small asp-validation-for="Gender"></small>
                        </label>
                    </div>
                </section>

                <section class="customer-profile-card">
                    <div class="customer-profile-card__heading">
                        <div>
                            <span class="eyebrow">ĐỊA CHỈ MẶC ĐỊNH</span>
                            <h2>Thông tin nhận hàng</h2>
                        </div>
                        <p>
                            Lưu địa chỉ thường dùng để quản lý hồ sơ
                            khách hàng đầy đủ hơn.
                        </p>
                    </div>

                    <div class="customer-profile-fields">
                        <label class="account-field">
                            <span>@Html.DisplayNameFor(x => x.Province)</span>
                            <select asp-for="Province"
                                    autocomplete="address-level1"
                                    data-vn-province
                                    data-current-value="@Model.Province">
                                <option value="">Đang tải tỉnh/thành phố...</option>
                            </select>
                            <small asp-validation-for="Province"></small>
                        </label>

                        <input asp-for="District"
                               type="hidden"
                               data-vn-district />

                        <label class="account-field">
                            <span>@Html.DisplayNameFor(x => x.Ward)</span>
                            <select asp-for="Ward"
                                    autocomplete="address-level2"
                                    data-vn-ward
                                    data-current-value="@Model.Ward">
                                <option value="">Chọn tỉnh/thành phố trước</option>
                            </select>
                            <small asp-validation-for="Ward"></small>
                        </label>

                        <div class="account-field customer-profile-field--wide vn-address-status"
                             data-vn-address-status
                             hidden></div>

                        <label class="account-field customer-profile-field--wide">
                            <span>@Html.DisplayNameFor(x => x.AddressLine)</span>
                            <input asp-for="AddressLine"
                                   autocomplete="street-address"
                                   placeholder="Số nhà, tên đường, tòa nhà..." />
                            <small asp-validation-for="AddressLine"></small>
                        </label>
                    </div>
                </section>

                <div class="customer-profile-save">
                    <span>
                        Thông tin được lưu riêng cho tài khoản đang đăng nhập.
                    </span>
                    <button class="store-button store-button--primary store-button--large"
                            type="submit">
                        Lưu hồ sơ khách hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <script src="~/store/js/vietnam-address.js"
            asp-append-version="true"></script>
}

