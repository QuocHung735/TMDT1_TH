@model MarketsViewModel
@{
    ViewData["Title"] = "Quản lý thị trường";
    ViewData["Description"] = "Quản lý khu vực và kênh bán để thiết lập giá theo đúng thị trường thực tế.";
    var formAction = Model.Form.Id.HasValue ? "Edit" : "Create";
    var modalTitle = Model.Form.Id.HasValue ? "Chỉnh sửa thị trường" : "Thêm thị trường";
}
@section PageActions {
    <button class="btn btn-primary" type="button" data-modal-target="market-modal"><i class="bi bi-plus-lg"></i> Thêm thị trường</button>
}

<section class="summary-strip">
    <div><span class="summary-strip__icon tone-purple"><i class="bi bi-globe-asia-australia"></i></span><p><strong>@Model.TotalCount</strong><small>Tổng thị trường</small></p></div>
    <div><span class="summary-strip__icon tone-mint"><i class="bi bi-broadcast-pin"></i></span><p><strong>@Model.ActiveCount</strong><small>Đang hoạt động</small></p></div>
    <div><span class="summary-strip__icon tone-amber"><i class="bi bi-tags"></i></span><p><strong>@Model.TotalPriceCount</strong><small>Lịch giá trong hệ thống</small></p></div>
</section>

<section class="card panel catalog-filter-panel">
    <form method="get" class="toolbar">
        <label class="field-search"><i class="bi bi-search"></i><input type="search" name="q" value="@Model.Search" placeholder="Tìm tên, mã, tiền tệ hoặc quốc gia..." /></label>
        <div class="toolbar__filters">
            <select class="form-select" name="active">
                <option value="">Tất cả trạng thái</option>
                @if (Model.Active == true)
                {
                    <option value="true" selected>Đang hoạt động</option>
                }
                else
                {
                    <option value="true">Đang hoạt động</option>
                }
                @if (Model.Active == false)
                {
                    <option value="false" selected>Tạm ẩn</option>
                }
                else
                {
                    <option value="false">Tạm ẩn</option>
                }
            </select>
            <button class="btn btn-light" type="submit"><i class="bi bi-funnel"></i> Lọc</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Active.HasValue)
            {
                <a class="btn btn-light" asp-action="Index"><i class="bi bi-x-lg"></i> Xóa lọc</a>
            }
        </div>
    </form>
</section>

@if (Model.Items.Count == 0)
{
    <section class="card empty-state">
        <span class="empty-state__icon"><i class="bi bi-globe-asia-australia"></i></span>
        <h2>Chưa có thị trường phù hợp</h2>
        <p>Hãy tạo thị trường đầu tiên hoặc thay đổi điều kiện tìm kiếm.</p>
        <button class="btn btn-primary" type="button" data-modal-target="market-modal"><i class="bi bi-plus-lg"></i> Thêm thị trường</button>
    </section>
}
else
{
    <section class="card panel">
        <div class="panel__header">
            <div><h2>Danh sách thị trường</h2><p>Số liệu lịch giá và trạng thái được truy vấn trực tiếp từ SQL Server.</p></div>
            <span class="panel-badge">@Model.Items.Count thị trường hiển thị</span>
        </div>
        <div class="market-list">
            @foreach (var item in Model.Items)
            {
                <article class="market-row">
                    <span class="market-row__icon"><i class="bi @(item.Code == "ONLINE" ? "bi-globe2" : "bi-geo-alt")"></i></span>
                    <div class="market-row__name">
                        <strong>
                            @item.Name
                            @if (item.IsDefault)
                            {
                                <em>Mặc định</em>
                            }
                        </strong>
                        <small>@item.Code · @item.CountryCode</small>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <span class="market-description">@item.Description</span>
                        }
                    </div>
                    <div><small>Tiền tệ</small><strong>@item.Currency</strong></div>
                    <div><small>Tổng lịch giá</small><strong>@item.PriceCount</strong></div>
                    <div><small>Đang áp dụng</small><strong>@item.ActivePriceCount</strong></div>
                    <span class="status-pill @UiStatus.Class(item.Status)">@item.Status</span>
                    <div class="table-actions market-actions">
                        <a class="icon-btn" asp-action="Index" asp-route-editId="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                        @if (!item.IsDefault)
                        {
                            <form asp-action="SetDefault" method="post" onsubmit="return confirm('Đặt thị trường này làm mặc định?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="icon-btn" type="submit" title="Đặt làm mặc định"><i class="bi bi-star"></i></button>
                            </form>
                        }
                        @if (item.IsDefault && item.IsActive)
                        {
                            <button class="icon-btn" type="button" title="Không thể tạm tắt thị trường mặc định" disabled><i class="bi bi-eye-slash"></i></button>
                        }
                        else
                        {
                            <form asp-action="Toggle" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="icon-btn" type="submit" title="@(item.IsActive ? "Tạm tắt" : "Kích hoạt")"><i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i></button>
                            </form>
                        }
                        @if (item.IsDefault)
                        {
                            <button class="icon-btn icon-btn--danger" type="button" title="Không thể xóa thị trường mặc định" disabled><i class="bi bi-trash3"></i></button>
                        }
                        else
                        {
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa thị trường này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="icon-btn icon-btn--danger" type="submit" title="Xóa"><i class="bi bi-trash3"></i></button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="card info-card">
    <span><i class="bi bi-info-circle"></i></span>
    <div>
        <h2>Cách hệ thống chọn giá</h2>
        <p>Hệ thống ưu tiên giá của biến thể tại đúng thị trường. Nếu chưa có, hệ thống dùng giá toàn sản phẩm tại thị trường đó; sau cùng mới tìm giá ở thị trường mặc định.</p>
    </div>
</section>

<div class="modal @(Model.OpenFormModal ? "is-open" : string.Empty)" id="market-modal" aria-hidden="@(!Model.OpenFormModal).ToString().ToLowerInvariant()">
    <div class="modal__backdrop" data-modal-close></div>
    <div class="modal__dialog">
        <form asp-action="@formAction" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Form.Id" />
            <div class="modal__header">
                <div><h2>@modalTitle</h2><p>Khai báo thị trường để sản phẩm và bảng giá sử dụng dữ liệu thật.</p></div>
                <a class="icon-btn" asp-action="Index" aria-label="Đóng"><i class="bi bi-x-lg"></i></a>
            </div>
            <div class="modal__body form-stack">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-grid form-grid--2">
                    <label class="form-field">
                        <span>Mã thị trường <em>*</em></span>
                        <input name="Code" value="@Model.Form.Code" maxlength="30" placeholder="Ví dụ: VN-DN" />
                        <small>Chỉ dùng chữ, số và dấu gạch ngang.</small>
                        @Html.ValidationMessage("Code", null, new { @class = "field-error" })
                    </label>
                    <label class="form-field">
                        <span>Tên thị trường <em>*</em></span>
                        <input name="Name" value="@Model.Form.Name" maxlength="150" placeholder="Ví dụ: Đà Nẵng" />
                        @Html.ValidationMessage("Name", null, new { @class = "field-error" })
                    </label>
                </div>

                <div class="form-grid form-grid--2">
                    <label class="form-field">
                        <span>Mã tiền tệ <em>*</em></span>
                        <input name="CurrencyCode" value="@Model.Form.CurrencyCode" maxlength="10" placeholder="VND" />
                        @Html.ValidationMessage("CurrencyCode", null, new { @class = "field-error" })
                    </label>
                    <label class="form-field">
                        <span>Mã quốc gia</span>
                        <input name="CountryCode" value="@Model.Form.CountryCode" maxlength="10" placeholder="VN" />
                        @Html.ValidationMessage("CountryCode", null, new { @class = "field-error" })
                    </label>
                </div>

                <label class="form-field">
                    <span>Mô tả</span>
                    <textarea name="Description" rows="3" maxlength="500" placeholder="Phạm vi áp dụng hoặc kênh bán của thị trường...">@Model.Form.Description</textarea>
                    @Html.ValidationMessage("Description", null, new { @class = "field-error" })
                </label>

                <label class="switch-row">
                    <span><strong>Thị trường đang hoạt động</strong><small>Cho phép chọn thị trường khi tạo sản phẩm và thiết lập giá.</small></span>
                    <input name="IsActive" type="checkbox" value="true" checked="@Model.Form.IsActive" /><i></i>
                </label>

                <label class="switch-row">
                    <span><strong>Đặt làm thị trường mặc định</strong><small>Thị trường mặc định được dùng khi chưa có bảng giá riêng cho khu vực.</small></span>
                    <input name="IsDefault" type="checkbox" value="true" checked="@Model.Form.IsDefault" /><i></i>
                </label>
            </div>
            <div class="modal__footer">
                <a class="btn btn-light" asp-action="Index">Hủy</a>
                <button class="btn btn-primary" type="submit">@(Model.Form.Id.HasValue ? "Lưu thay đổi" : "Lưu thị trường")</button>
            </div>
        </form>
    </div>
</div>
