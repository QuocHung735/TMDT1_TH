@{
    var title = ViewData["Title"] as string ?? "Mây Home";
    var authenticated = User.Identity?.IsAuthenticated == true;
    var accountName = User.Identity?.Name ?? string.Empty;
    var accountInitial = string.IsNullOrWhiteSpace(accountName)
        ? "K"
        : accountName[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Mây Home</title>
    <meta name="description" content="Mây Home - Đồ gia dụng tiện nghi cho mọi gia đình." />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/store/css/store.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/store/css/cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/store/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/store/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/store/css/reviews.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/store/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/store/css/shipping.css" asp-append-version="true" />
</head>
<body>
    <div class="store-announcement">
        Miễn phí giao hàng cho đơn đủ điều kiện · Đổi trả theo chính sách cửa hàng
    </div>

    <header class="store-header">
        <div class="store-container store-header__inner">
            <a class="store-brand" asp-controller="Home" asp-action="Index">
                <span class="store-brand__mark">M</span>
                <span>
                    <strong>Mây Home</strong>
                    <small>GIA DỤNG</small>
                </span>
            </a>

            <form class="store-search"
                  asp-controller="Home"
                  asp-action="Catalog"
                  method="get">
                <input type="search"
                       name="q"
                       value="@Context.Request.Query["q"]"
                       placeholder="Tìm nồi chiên, máy xay, đồ dùng nhà bếp..." />
                <button type="submit" aria-label="Tìm kiếm">Tìm kiếm</button>
            </form>

            <nav class="store-actions" aria-label="Tài khoản và giỏ hàng">
                @if (authenticated)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Index">Quản trị</a>
                    }

                    <a class="store-profile-link"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Profile"
                       title="Mở hồ sơ khách hàng">
                        <span class="store-profile-link__avatar">
                            @accountInitial
                        </span>
                        <span>Hồ sơ</span>
                    </a>

                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="store-logout-form">
                        <button type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Login">Đăng nhập</a>
                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Register">Đăng ký</a>
                }

                <a class="store-cart-preview"
                   asp-area=""
                   asp-controller="Cart"
                   asp-action="Index"
                   title="Mở giỏ hàng">
                    Giỏ hàng <b data-cart-count>0</b>
                </a>
            </nav>
        </div>

        <nav class="store-nav" aria-label="Điều hướng chính">
            <div class="store-container store-nav__inner">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="Home" asp-action="Catalog">Tất cả sản phẩm</a>
                <a asp-controller="Home" asp-action="Catalog" asp-route-sort="newest">Sản phẩm mới</a>
                <a asp-controller="Home" asp-action="Catalog" asp-route-sort="price-asc">Giá tốt</a>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="store-footer">
        <div class="store-container store-footer__grid">
            <section>
                <a class="store-brand store-brand--footer"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="store-brand__mark">M</span>
                    <span><strong>Mây Home</strong><small>GIA DỤNG</small></span>
                </a>
                <p>Không gian mua sắm đồ gia dụng rõ nguồn gốc, giá minh bạch và dễ lựa chọn.</p>
            </section>
            <section>
                <h3>Mua sắm</h3>
                <a asp-controller="Home" asp-action="Catalog">Tất cả sản phẩm</a>
                <a asp-controller="Home" asp-action="Catalog" asp-route-sort="newest">Sản phẩm mới</a>
            </section>
            <section>
                <h3>Tài khoản</h3>
                @if (authenticated)
                {
                    <a asp-controller="Account" asp-action="Profile">Hồ sơ khách hàng</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register">Đăng ký</a>
                }
            </section>
            <section>
                <h3>Liên hệ</h3>
                <span>Hỗ trợ trong giờ hành chính</span>
                <span>Thông tin liên hệ sẽ cấu hình ở bước cài đặt cửa hàng.</span>
            </section>
        </div>
        <div class="store-footer__bottom">
            <div class="store-container">© @DateTime.Now.Year Mây Home.</div>
        </div>
    </footer>

    <form id="store-antiforgery" hidden>
        @Html.AntiForgeryToken()
    </form>

    <script src="~/store/js/store.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
