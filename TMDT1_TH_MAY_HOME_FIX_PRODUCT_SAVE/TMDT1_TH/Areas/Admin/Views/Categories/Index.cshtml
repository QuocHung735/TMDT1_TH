@model CategoriesViewModel
@{
    ViewData["Title"] = "Quản lý danh mục";
    ViewData["Description"] = "Tổ chức sản phẩm theo cấu trúc dễ tìm kiếm và thuận tiện cho người mua.";
    var formAction = Model.Form.Id.HasValue ? "Edit" : "Create";
    var modalTitle = Model.Form.Id.HasValue ? "Chỉnh sửa danh mục" : "Thêm danh mục mới";
}
@section PageActions {
    <button class="btn btn-primary" type="button" data-modal-target="category-modal"><i class="bi bi-plus-lg"></i> Thêm danh mục</button>
}

<section class="summary-strip">
    <div><span class="summary-strip__icon tone-purple"><i class="bi bi-diagram-3"></i></span><p><strong>@Model.TotalCount</strong><small>Tổng danh mục</small></p></div>
    <div><span class="summary-strip__icon tone-mint"><i class="bi bi-eye"></i></span><p><strong>@Model.ActiveCount</strong><small>Đang hiển thị</small></p></div>
    <div><span class="summary-strip__icon tone-amber"><i class="bi bi-box-seam"></i></span><p><strong>@Model.ProductCount</strong><small>Sản phẩm đã gán</small></p></div>
</section>

<section class="card panel">
    <form method="get" class="toolbar">
        <label class="field-search"><i class="bi bi-search"></i><input type="search" name="q" value="@Model.Search" placeholder="Tìm theo tên hoặc slug..." /></label>
        <div class="toolbar__filters">
            <select class="form-select" name="active">
                <option value="" selected="@(!Model.Active.HasValue)">Tất cả trạng thái</option>
                <option value="true" selected="@(Model.Active == true)">Đang hiển thị</option>
                <option value="false" selected="@(Model.Active == false)">Đã ẩn</option>
            </select>
            <button class="btn btn-light" type="submit"><i class="bi bi-funnel"></i> Lọc</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Active.HasValue)
            {
                <a class="btn btn-light" asp-action="Index"><i class="bi bi-x-lg"></i> Xóa lọc</a>
            }
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state empty-state--compact">
            <span class="empty-state__icon"><i class="bi bi-folder2-open"></i></span>
            <h2>Chưa có danh mục phù hợp</h2>
            <p>Hãy tạo danh mục đầu tiên hoặc thay đổi điều kiện tìm kiếm.</p>
            <button class="btn btn-primary" type="button" data-modal-target="category-modal"><i class="bi bi-plus-lg"></i> Thêm danh mục</button>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table" id="category-table">
                <thead><tr><th>Danh mục</th><th>Slug</th><th>Danh mục cha</th><th>Thứ tự</th><th>Sản phẩm</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><div class="category-cell" style="--level:@item.Level"><span class="category-icon"><i class="bi @item.Icon"></i></span><strong>@item.Name</strong></div></td>
                        <td><code>@item.Slug</code></td>
                        <td>@item.Parent</td>
                        <td>@item.DisplayOrder</td>
                        <td>@item.ProductCount sản phẩm</td>
                        <td><span class="status-pill @UiStatus.Class(item.Status)">@item.Status</span></td>
                        <td class="table-actions">
                            <a class="icon-btn" title="Chỉnh sửa" asp-action="Index" asp-route-editId="@item.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Toggle" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="icon-btn" type="submit" title="@(item.IsActive ? "Ẩn danh mục" : "Hiển thị danh mục")"><i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i></button>
                            </form>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa danh mục này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="icon-btn icon-btn--danger" type="submit" title="Xóa"><i class="bi bi-trash3"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="pagination"><span>Hiển thị @Model.Items.Count trong @Model.TotalCount danh mục</span></div>
    }
</section>

<div class="modal @(Model.OpenFormModal ? "is-open" : string.Empty)" id="category-modal" aria-hidden="@(!Model.OpenFormModal).ToString().ToLowerInvariant()">
    <div class="modal__backdrop" data-modal-close></div>
    <div class="modal__dialog">
        <form asp-action="@formAction" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Form.Id" />
            <div class="modal__header">
                <div><h2>@modalTitle</h2><p>Tạo cấu trúc rõ ràng để khách dễ tìm sản phẩm.</p></div>
                <a class="icon-btn" asp-action="Index" aria-label="Đóng"><i class="bi bi-x-lg"></i></a>
            </div>
            <div class="modal__body form-stack">
                <div asp-validation-summary="All" class="validation-summary"></div>

                <label class="form-field">
                    <span>Tên danh mục <em>*</em></span>
                    <input name="Name" value="@Model.Form.Name" placeholder="Ví dụ: Dụng cụ nhà bếp" />
                    @Html.ValidationMessage("Name", null, new { @class = "field-error" })
                </label>

                <label class="form-field">
                    <span>Slug</span>
                    <input name="Slug" value="@Model.Form.Slug" placeholder="Để trống để tự tạo từ tên" />
                    <small>Slug trống sẽ được hệ thống tự tạo và chống trùng.</small>
                    @Html.ValidationMessage("Slug", null, new { @class = "field-error" })
                </label>

                <label class="form-field">
                    <span>Danh mục cha</span>
                    <select name="ParentId" asp-items="Model.ParentOptions"></select>
                    @Html.ValidationMessage("ParentId", null, new { @class = "field-error" })
                </label>

                <div class="form-grid form-grid--2">
                    <label class="form-field">
                        <span>Thứ tự hiển thị</span>
                        <input name="DisplayOrder" value="@Model.Form.DisplayOrder" type="number" min="0" />
                        @Html.ValidationMessage("DisplayOrder", null, new { @class = "field-error" })
                    </label>
                    <label class="form-field">
                        <span>Đường dẫn ảnh</span>
                        <input name="ImageUrl" value="@Model.Form.ImageUrl" placeholder="/uploads/categories/..." />
                        @Html.ValidationMessage("ImageUrl", null, new { @class = "field-error" })
                    </label>
                </div>

                <label class="form-field">
                    <span>Mô tả ngắn</span>
                    <textarea name="Description" rows="3" placeholder="Giúp đội ngũ hiểu phạm vi của danh mục...">@Model.Form.Description</textarea>
                    @Html.ValidationMessage("Description", null, new { @class = "field-error" })
                </label>

                <label class="switch-row">
                    <span><strong>Hiển thị trên cửa hàng</strong><small>Khách hàng có thể nhìn thấy danh mục này.</small></span>
                    <input name="IsActive" type="checkbox" value="true" checked="@Model.Form.IsActive" /><i></i>
                </label>
            </div>
            <div class="modal__footer">
                <a class="btn btn-light" asp-action="Index">Hủy</a>
                <button class="btn btn-primary" type="submit">@(Model.Form.Id.HasValue ? "Lưu thay đổi" : "Lưu danh mục")</button>
            </div>
        </form>
    </div>
</div>
