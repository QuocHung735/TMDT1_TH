@model TMDT1_TH.ViewModels.Account.ChangePasswordViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="account-page account-page--profile">
    <div class="store-container account-profile-layout">
        <aside class="account-menu">
            <h2>Tài khoản</h2>
            <a asp-controller="Account"
               asp-action="Profile">Thông tin cá nhân</a>
            <a asp-controller="MyOrders"
               asp-action="Index">Đơn hàng của tôi</a>
            <a class="is-active"
               asp-controller="Account"
               asp-action="ChangePassword">Đổi mật khẩu</a>
        </aside>

        <form asp-action="ChangePassword"
              method="post"
              class="account-card">
            <h1>Đổi mật khẩu</h1>
            <p class="account-card__lead">
                Mật khẩu mới cần chữ hoa, chữ thường, chữ số và ký tự đặc biệt.
            </p>

            <div asp-validation-summary="ModelOnly"
                 class="account-validation"></div>

            <label class="account-field">
                <span>@Html.DisplayNameFor(x => x.CurrentPassword)</span>
                <input asp-for="CurrentPassword"
                       autocomplete="current-password" />
                <small asp-validation-for="CurrentPassword"></small>
            </label>

            <label class="account-field">
                <span>@Html.DisplayNameFor(x => x.NewPassword)</span>
                <input asp-for="NewPassword"
                       autocomplete="new-password" />
                <small asp-validation-for="NewPassword"></small>
            </label>

            <label class="account-field">
                <span>@Html.DisplayNameFor(x => x.ConfirmPassword)</span>
                <input asp-for="ConfirmPassword"
                       autocomplete="new-password" />
                <small asp-validation-for="ConfirmPassword"></small>
            </label>

            <button class="store-button store-button--primary"
                    type="submit">
                Cập nhật mật khẩu
            </button>
        </form>
    </div>
</section>
