@using System.Globalization
@using TMDT1_TH.Domain.Enums
@using TMDT1_TH.ViewModels.Storefront
@model AdminOrdersViewModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    ViewData["Description"] =
        "Xác nhận, chuẩn bị, giao và hoàn tất đơn hàng của khách.";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="segmented-stats">
    <a class="@(!Model.Status.HasValue ? "is-active" : "")"
       asp-action="Index">
        <strong>@Model.TotalCount</strong><span>Tất cả</span>
    </a>
    <a class="@(Model.Status == OrderStatus.Pending ? "is-active" : "")"
       asp-action="Index"
       asp-route-status="@OrderStatus.Pending">
        <strong>@Model.PendingCount</strong><span>Chờ xác nhận</span>
    </a>
    <a class="@(Model.Status == OrderStatus.Shipping ? "is-active" : "")"
       asp-action="Index"
       asp-route-status="@OrderStatus.Shipping">
        <strong>@Model.ShippingCount</strong><span>Đang giao</span>
    </a>
    <a class="@(Model.Status == OrderStatus.Completed ? "is-active" : "")"
       asp-action="Index"
       asp-route-status="@OrderStatus.Completed">
        <strong>@Model.CompletedCount</strong><span>Hoàn thành</span>
    </a>
    <a class="@(Model.Status == OrderStatus.Cancelled ? "is-active" : "")"
       asp-action="Index"
       asp-route-status="@OrderStatus.Cancelled">
        <strong>@Model.CancelledCount</strong><span>Đã hủy</span>
    </a>
</section>

<section class="card panel">
    <form method="get" class="toolbar toolbar--wrap">
        <label class="field-search">
            <i class="bi bi-search"></i>
            <input type="search"
                   name="q"
                   value="@Model.Query"
                   placeholder="Mã đơn, tên, điện thoại, email..." />
        </label>

        <div class="toolbar__filters">
            <select class="form-select"
                    name="status">
                <option value="">Tất cả trạng thái</option>
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <option value="@((int)status)"
                            selected="@(Model.Status == status)">
                        @OrderDisplay.StatusName(status)
                    </option>
                }
            </select>
            <button class="btn btn-light" type="submit">
                <i class="bi bi-funnel"></i> Lọc
            </button>
            <a class="btn btn-light"
               asp-action="Index">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Đơn hàng</th>
                    <th>Khách hàng</th>
                    <th>Số lượng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="6">
                        <div class="admin-order-empty">
                            Chưa có đơn hàng phù hợp.
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var order in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="stacked-text">
                                <strong>@order.OrderNumber</strong>
                                <small>
                                    @VietnamDateTime.Format(order.CreatedAt, "dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        </td>
                        <td>
                            <div class="stacked-text">
                                <strong>@order.CustomerName</strong>
                                <small>@order.CustomerPhone</small>
                            </div>
                        </td>
                        <td>@order.TotalQuantity sản phẩm</td>
                        <td>
                            <strong>
                                @order.TotalAmount.ToString("N0", culture)
                                @order.CurrencyCode
                            </strong>
                        </td>
                        <td>
                            <span class="customer-order-status @order.StatusClass">
                                @order.StatusName
                            </span>
                        </td>
                        <td class="table-actions">
                            <a class="icon-btn"
                               asp-action="Details"
                               asp-route-id="@order.Id"
                               title="Xem và xử lý">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

