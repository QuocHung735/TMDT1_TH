@model CategoryFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Chỉnh sửa danh mục" : "Thêm danh mục";
    ViewData["Description"] = "Thông tin rõ ràng giúp khách hàng tìm sản phẩm nhanh hơn.";
}
<form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="card panel form-stack">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-grid form-grid--2">
        <label class="form-field"><span asp-for="Name"></span><input asp-for="Name" /><span asp-validation-for="Name" class="text-danger"></span></label>
        <label class="form-field"><span>Slug</span><input asp-for="Slug" placeholder="Để trống để tự tạo" /></label>
    </div>
    <div class="form-grid form-grid--2">
        <label class="form-field"><span asp-for="ParentId"></span><select asp-for="ParentId" asp-items="Model.ParentOptions"><option value="">Không có</option></select></label>
        <label class="form-field"><span asp-for="DisplayOrder"></span><input asp-for="DisplayOrder" type="number" min="0" /></label>
    </div>
    <label class="form-field"><span asp-for="ImageUrl"></span><input asp-for="ImageUrl" /></label>
    <label class="form-field"><span asp-for="Description"></span><textarea asp-for="Description" rows="4"></textarea></label>
    <label class="switch-row"><span><strong>Hiển thị trên cửa hàng</strong><small>Cho phép khách hàng nhìn thấy danh mục.</small></span><input asp-for="IsActive" /><i></i></label>
    <div class="modal__footer"><a class="btn btn-light" asp-action="Index">Hủy</a><button class="btn btn-primary" type="submit">Lưu danh mục</button></div>
</form>
