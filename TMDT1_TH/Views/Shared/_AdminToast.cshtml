@if (TempData["Success"] is string success)
{
    <div class="toast-message toast-message--success" data-toast>
        <i class="bi bi-check-circle-fill"></i>
        <div><strong>Đã hoàn tất</strong><span>@success</span></div>
        <button type="button" data-toast-close aria-label="Đóng"><i class="bi bi-x"></i></button>
    </div>
}
@if (TempData["Info"] is string info)
{
    <div class="toast-message toast-message--info" data-toast>
        <i class="bi bi-info-circle-fill"></i>
        <div><strong>Thông tin</strong><span>@info</span></div>
        <button type="button" data-toast-close aria-label="Đóng"><i class="bi bi-x"></i></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="toast-message toast-message--error" data-toast>
        <i class="bi bi-exclamation-circle-fill"></i>
        <div><strong>Không thể thực hiện</strong><span>@error</span></div>
        <button type="button" data-toast-close aria-label="Đóng"><i class="bi bi-x"></i></button>
    </div>
}
