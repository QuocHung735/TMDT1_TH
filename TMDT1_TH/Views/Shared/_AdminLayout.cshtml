@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Trang quản trị";
    var pageDescription = ViewData["Description"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#8b7cf6" />
    <title>@pageTitle - Lumi Commerce</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/admin/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell" data-app-shell>
        <partial name="_AdminSidebar" />
        <div class="sidebar-overlay" data-sidebar-overlay></div>

        <div class="app-main">
            <partial name="_AdminTopbar" />

            <main class="page-content">
                <div class="page-heading">
                    <div>
                        <nav class="breadcrumb" aria-label="Điều hướng">
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a>
                            <i class="bi bi-chevron-right"></i>
                            <span>@pageTitle</span>
                        </nav>
                        <h1>@pageTitle</h1>
                        @if (!string.IsNullOrWhiteSpace(pageDescription))
                        {
                            <p>@pageDescription</p>
                        }
                    </div>
                    <div class="page-heading__actions">
                        @await RenderSectionAsync("PageActions", required: false)
                    </div>
                </div>

                <partial name="_AdminToast" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/admin/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
