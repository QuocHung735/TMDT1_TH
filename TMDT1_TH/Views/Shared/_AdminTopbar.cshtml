@{
    var email = User.Identity?.Name ?? "admin";
    var initials = string.Join(
        string.Empty,
        email.Split(
                new[] { ' ', '@', '.', '_' },
                StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => char.ToUpperInvariant(x[0])));
}
<header class="admin-topbar">
    <button class="icon-btn topbar-menu"
            type="button"
            data-sidebar-toggle
            aria-label="Mở menu">
        <i class="bi bi-list"></i>
    </button>

    <label class="global-search">
        <i class="bi bi-search"></i>
        <input type="search"
               placeholder="Tìm sản phẩm, SKU, đơn hàng..."
               aria-label="Tìm kiếm toàn hệ thống" />
        <kbd>Ctrl K</kbd>
    </label>

    <div class="topbar-actions">
        <button class="icon-btn has-indicator"
                type="button"
                title="Thông báo">
            <i class="bi bi-bell"></i><span></span>
        </button>
        <button class="profile-button"
                type="button"
                data-dropdown-toggle>
            <span class="avatar">@initials</span>
            <span class="profile-button__text">
                <strong>@email</strong><small>Quản trị viên</small>
            </span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="profile-menu" data-dropdown-menu>
            <a asp-area=""
               asp-controller="Account"
               asp-action="Profile">
                <i class="bi bi-person"></i> Hồ sơ cá nhân
            </a>
            <a asp-area=""
               asp-controller="Home"
               asp-action="Index">
                <i class="bi bi-shop"></i> Xem cửa hàng
            </a>
            <hr />
            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">
                <button type="submit">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>
</header>
