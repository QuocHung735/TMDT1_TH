@model PricingIndexViewModel
@{
    ViewData["Title"] = "Quản lý giá";
    ViewData["Description"] = "Thiết lập ba mức giá theo sản phẩm hoặc biến thể, thị trường và thời gian áp dụng.";
    var modalClass = Model.OpenFormModal ? "is-open" : string.Empty;
    var modalHidden = Model.OpenFormModal ? "false" : "true";
    var formTitle = Model.Form.IsEdit ? "Chỉnh sửa lịch giá" : "Thiết lập lịch giá";
}
@section PageActions {
    <a class="btn btn-light" asp-action="ExportHistory"><i class="bi bi-download"></i> Xuất lịch sử</a>
    <button class="btn btn-primary" type="button" data-modal-target="price-modal"><i class="bi bi-plus-lg"></i> Thiết lập giá</button>
}

<section class="pricing-overview">
    <article class="pricing-overview__card">
        <span class="tone-purple"><i class="bi bi-tags"></i></span>
        <div><small>Đang áp dụng</small><strong>@Model.CurrentCount</strong><em>trên @Model.ActiveMarketCount thị trường</em></div>
    </article>
    <article class="pricing-overview__card">
        <span class="tone-mint"><i class="bi bi-calendar2-check"></i></span>
        <div><small>Sắp có hiệu lực</small><strong>@Model.UpcomingCount</strong><em>trong 7 ngày tới</em></div>
    </article>
    <article class="pricing-overview__card">
        <span class="tone-amber"><i class="bi bi-hourglass-split"></i></span>
        <div><small>Sắp hết hạn</small><strong>@Model.ExpiringCount</strong><em>cần xem xét gia hạn</em></div>
    </article>
    <article class="pricing-overview__card">
        <span class="tone-blue"><i class="bi bi-graph-up-arrow"></i></span>
        <div><small>Thay đổi tháng này</small><strong>@Model.ChangedThisMonthCount</strong><em>được trigger ghi nhận</em></div>
    </article>
</section>

<div class="tabs" data-tabs>
    <button class="is-active" type="button" data-tab="current-prices">Lịch giá</button>
    <button type="button" data-tab="price-history">Lịch sử biến động</button>
</div>

<section class="card panel" data-tab-panel="current-prices">
    <form method="get" class="toolbar toolbar--wrap">
        <label class="field-search">
            <i class="bi bi-search"></i>
            <input type="search" name="q" value="@Model.Query" placeholder="Tìm sản phẩm, SKU, biến thể hoặc thị trường..." />
        </label>
        <div class="toolbar__filters">
            <select asp-for="MarketId" class="form-select" asp-items="Model.MarketFilterOptions">
                <option value="">Tất cả thị trường</option>
            </select>
            <select asp-for="State" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="current">Đang áp dụng</option>
                <option value="upcoming">Sắp áp dụng</option>
                <option value="expiring">Sắp hết hạn</option>
                <option value="expired">Hết hạn</option>
                <option value="inactive">Tạm tắt</option>
            </select>
            <button class="btn btn-light" type="submit"><i class="bi bi-funnel"></i> Lọc</button>
            <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>

    <div class="table-wrap">
        <table class="data-table" id="pricing-table">
            <thead>
                <tr>
                    <th>Sản phẩm / Biến thể</th>
                    <th>Thị trường</th>
                    <th>Giá vốn</th>
                    <th>Giá niêm yết</th>
                    <th>Giá bán</th>
                    <th>Thời gian áp dụng</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="8"><div class="empty-state"><i class="bi bi-tags"></i><strong>Chưa có lịch giá phù hợp</strong><p>Hãy tạo lịch giá mới hoặc thay đổi bộ lọc.</p></div></td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    var toggleTitle = item.IsActive ? "Tạm tắt" : "Kích hoạt";
                    var toggleIcon = item.IsActive ? "bi-pause-circle" : "bi-play-circle";
                    <tr>
                        <td>
                            <div class="stacked-text">
                                <strong>@item.Product</strong>
                                <small>@item.Variant · @item.Sku</small>
                            </div>
                        </td>
                        <td><span class="market-chip"><i class="bi bi-geo-alt"></i>@item.Market</span></td>
                        <td>@item.CostPrice</td>
                        <td><span class="muted-price">@item.ListPrice</span></td>
                        <td><strong class="sale-price">@item.SalePrice</strong></td>
                        <td>@item.Period</td>
                        <td><span class="status-pill @UiStatus.Class(item.Status)">@item.Status</span></td>
                        <td class="table-actions">
                            <a class="icon-btn" asp-action="Index" asp-route-editId="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="ToggleStatus" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="icon-btn" type="submit" title="@toggleTitle">
                                    <i class="bi @toggleIcon"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="inline-form" onsubmit="return confirm('Xóa lịch giá này? Lịch sử thay đổi vẫn được giữ lại.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="icon-btn icon-btn--danger" type="submit" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <div class="pagination"><span>Hiển thị @Model.Items.Count lịch giá</span></div>
</section>

<section class="card panel is-hidden" data-tab-panel="price-history">
    <div class="panel__header">
        <div><h2>Lịch sử biến động giá</h2><p>Dữ liệu được trigger SQL Server ghi tự động khi thêm, sửa hoặc xóa lịch giá.</p></div>
        <a class="btn btn-light" asp-action="ExportHistory"><i class="bi bi-download"></i> Xuất CSV</a>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr><th>Sản phẩm / Biến thể</th><th>Thị trường</th><th>Nội dung</th><th>Giá trị cũ</th><th>Giá trị mới</th><th>Thay đổi</th><th>Người cập nhật</th><th>Thời gian</th></tr>
            </thead>
            <tbody>
            @if (Model.History.Count == 0)
            {
                <tr><td colspan="8"><div class="empty-state"><i class="bi bi-clock-history"></i><strong>Chưa có lịch sử</strong><p>Lịch sử sẽ xuất hiện sau lần thay đổi giá đầu tiên.</p></div></td></tr>
            }
            else
            {
                @foreach (var item in Model.History)
                {
                    <tr title="@item.Reason">
                        <td><div class="stacked-text"><strong>@item.Product</strong><small>@item.Variant · @item.Action</small></div></td>
                        <td>@item.Market</td>
                        <td>@item.ChangeType</td>
                        <td class="muted-price">@item.OldValue</td>
                        <td><strong>@item.NewValue</strong></td>
                        <td><span class="change-pill change-pill--@item.Tone">@item.Change</span></td>
                        <td>@item.User</td>
                        <td>@item.Time</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

<div class="modal modal--wide @modalClass" id="price-modal" aria-hidden="@modalHidden">
    <div class="modal__backdrop" data-modal-close></div>
    <div class="modal__dialog">
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Form.Id" type="hidden" />
            <input asp-for="Query" type="hidden" />
            <input asp-for="MarketId" type="hidden" />
            <input asp-for="State" type="hidden" />

            <div class="modal__header">
                <div>
                    <h2>@formTitle</h2>
                    <p>Chọn sản phẩm hoặc biến thể, thị trường và thời gian áp dụng.</p>
                </div>
                <button type="button" class="icon-btn" data-modal-close><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="modal__body form-stack">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-grid form-grid--2">
                    <label class="form-field">
                        <span>Sản phẩm hoặc biến thể <em>*</em></span>
                        <select asp-for="Form.TargetKey" asp-items="Model.Form.TargetOptions" required>
                            <option value="">Chọn mục tiêu áp dụng giá</option>
                        </select>
                        <span asp-validation-for="Form.TargetKey" class="field-error"></span>
                    </label>
                    <label class="form-field">
                        <span>Thị trường <em>*</em></span>
                        <select asp-for="Form.MarketId" asp-items="Model.Form.MarketOptions" required>
                            <option value="">Chọn thị trường</option>
                        </select>
                        <span asp-validation-for="Form.MarketId" class="field-error"></span>
                    </label>
                </div>

                <div class="price-input-grid">
                    <label class="form-field price-field">
                        <span>Giá vốn <em>*</em></span>
                        <div><input asp-for="Form.CostPrice" type="text" inputmode="numeric" asp-format="{0:0}" data-money-input /><i>₫</i></div>
                        <span asp-validation-for="Form.CostPrice" class="field-error"></span>
                    </label>
                    <label class="form-field price-field">
                        <span>Giá niêm yết <em>*</em></span>
                        <div><input asp-for="Form.ListPrice" type="text" inputmode="numeric" asp-format="{0:0}" data-money-input /><i>₫</i></div>
                        <span asp-validation-for="Form.ListPrice" class="field-error"></span>
                    </label>
                    <label class="form-field price-field price-field--highlight">
                        <span>Giá bán <em>*</em></span>
                        <div><input asp-for="Form.SalePrice" type="text" inputmode="numeric" asp-format="{0:0}" data-money-input /><i>₫</i></div>
                        <span asp-validation-for="Form.SalePrice" class="field-error"></span>
                    </label>
                </div>

                <div class="schedule-box">
                    <div class="schedule-box__head">
                        <strong>Thời gian áp dụng</strong>
                        <label class="switch-inline">
                            <input asp-for="Form.IsUnlimited" data-unlimited-price />
                            <span>Áp dụng vô hạn</span>
                        </label>
                    </div>
                    <div class="form-grid form-grid--2">
                        <label class="form-field">
                            <span>Bắt đầu <em>*</em></span>
                            <input asp-for="Form.ValidFrom" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="Form.ValidFrom" class="field-error"></span>
                        </label>
                        <label class="form-field" data-price-end-field>
                            <span>Kết thúc</span>
                            <input asp-for="Form.ValidTo" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="Form.ValidTo" class="field-error"></span>
                        </label>
                    </div>
                </div>

                <label class="switch-row switch-row--border">
                    <span><strong>Kích hoạt lịch giá</strong><small>Lịch giá tắt vẫn được lưu nhưng không tham gia tính giá.</small></span>
                    <input asp-for="Form.IsActive" /><i></i>
                </label>

                <div class="validation-banner">
                    <i class="bi bi-shield-check"></i>
                    <div><strong>Kiểm tra chồng thời gian</strong><p>Ứng dụng và trigger SQL Server cùng kiểm tra trước khi lưu.</p></div>
                </div>

                <label class="form-field">
                    <span>Lý do hoặc ghi chú</span>
                    <textarea asp-for="Form.Note" rows="3" placeholder="Ví dụ: Khuyến mãi cuối tháng, điều chỉnh theo thị trường..."></textarea>
                    <span asp-validation-for="Form.Note" class="field-error"></span>
                </label>
            </div>

            <div class="modal__footer">
                <button type="button" class="btn btn-light" data-modal-close>Hủy</button>
                <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> Lưu lịch giá</button>
            </div>
        </form>
    </div>
</div>
